<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudyDocumentManager.Views.AddDocumentDialog"
        Title="{Binding [AddDocDialog_Title], Source={StaticResource Loc}}"
        Width="520" Height="480"
        MinWidth="450" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource ContentBackground}">

    <Border Padding="{StaticResource PaddingPage}">
        <DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Image Source="{StaticResource IconAdd}" Width="20" Height="20"/>
                <TextBlock Text="{Binding [AddDocDialog_Title], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>


            <Border DockPanel.Dock="Top" Classes="info-banner">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{StaticResource IconOpenFile}" Width="13" Height="13"/>
                    <TextBlock Name="txtFilePath" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>


            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="primary" Name="btnSave" Click="OnSaveClick" Padding="20,8"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Image Source="{StaticResource IconCheck}" Width="13" Height="13"/>
                        <TextBlock Text="{Binding [AddEdit_BtnSave], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Name="btnCancel" Click="OnCancelClick" Padding="20,8"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Image Source="{StaticResource IconClose}" Width="10" Height="10"/>
                        <TextBlock Text="{Binding [AddEdit_BtnCancel], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeMd}"/>
                    </StackPanel>
                </Button>
            </StackPanel>


            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding [AddEdit_LblName], Source={StaticResource Loc}}" Classes="field-label"/>
                        <TextBox Name="txtTen" FontSize="{StaticResource FontSizeMd}"/>
                    </StackPanel>


                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding [AddEdit_LblSubject], Source={StaticResource Loc}}" Classes="field-label"/>
                            <ComboBox Name="cboMonHoc"
                                      IsTextSearchEnabled="True"
                                      FontSize="{StaticResource FontSizeMd}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="{Binding [AddEdit_LblType], Source={StaticResource Loc}}" Classes="field-label"/>
                            <ComboBox Name="cboLoai"
                                      IsTextSearchEnabled="True"
                                      FontSize="{StaticResource FontSizeMd}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>


                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding [AddEdit_LblAuthor], Source={StaticResource Loc}}" Classes="field-label"/>
                            <TextBox Name="txtTacGia" FontSize="{StaticResource FontSizeMd}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="Tags" Classes="field-label"/>
                            <TextBox Name="txtTags" Watermark="tag1, tag2, ..." FontSize="{StaticResource FontSizeMd}"/>
                        </StackPanel>
                    </Grid>


                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding [AddEdit_LblNotes], Source={StaticResource Loc}}" Classes="field-label"/>
                        <TextBox Name="txtGhiChu" FontSize="{StaticResource FontSizeMd}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                    </StackPanel>


                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <CheckBox Name="chkQuanTrong" Content="{Binding [AddEdit_LblImportant], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeMd}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding [AddEdit_LblDeadline], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <DatePicker Grid.Column="3" Name="dpDeadline" FontSize="{StaticResource FontSizeMd}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

</Window>
