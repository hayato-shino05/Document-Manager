<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:StudyDocumentManager.Markup"
                x:Class="StudyDocumentManager.Views.AddToCollectionDialog"
        AutomationProperties.AutomationId="Dialog_AddToCollection"
        Title="{loc:Localize AddToCollection_Title}"
        Width="680" Height="520"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource ContentBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">


        <Border Grid.Row="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingCard}">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleLabel"
                           AutomationProperties.AutomationId="AddToCollection_Title"
                           Text="{loc:Localize AddToCollection_Title}"
                           FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="SubtitleLabel"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{loc:Localize AddToCollection_Subtitle}"
                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>


        <Border Grid.Row="1" Padding="{StaticResource PaddingStatCard}" Background="{StaticResource ContentBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         AutomationProperties.AutomationId="AddToCollection_Search"
                         AutomationProperties.Name="{loc:Localize AddToCollection_SearchPlaceholder}"
                         Watermark="{loc:Localize AddToCollection_SearchPlaceholder}"
                         Height="30" VerticalContentAlignment="Center"
                         Padding="12,4,10,4"
                         FontSize="{StaticResource FontSizeMd}">
                    <TextBox.InnerLeftContent>
                        <Image Source="{StaticResource IconSearch}" 
                               Width="14" Height="14" 
                               Margin="10,0,0,0" 
                               Opacity="0.6"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock x:Name="CountLabel" Grid.Column="1"
                           AutomationProperties.AutomationId="AddToCollection_Count"
                           AutomationProperties.LiveSetting="Polite"
                           VerticalAlignment="Center" Margin="10,0,4,0"
                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"
                           Text="0"/>
                <Button x:Name="SelectAllBtn" Grid.Column="2"
                        AutomationProperties.AutomationId="AddToCollection_SelectAll"
                        AutomationProperties.Name="{loc:Localize Bulk_BtnSelectAll}"
                        Content="{loc:Localize Bulk_BtnSelectAll}" FontSize="{StaticResource FontSizeSm}"
                        Padding="{StaticResource PaddingChip}" VerticalAlignment="Center"
                        Classes="secondary" Margin="4,0,0,0"/>
            </Grid>
        </Border>


        <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                Margin="12,8,12,0">
            <Grid RowDefinitions="Auto,*">


                <Border Grid.Row="0" Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                        Padding="{StaticResource PaddingMd}">
                    <Grid ColumnDefinitions="32,*,130,80">
                        <CheckBox x:Name="HeaderCheckBox" Grid.Column="0"
                                  AutomationProperties.AutomationId="AddToCollection_HeaderSelection"
                                  AutomationProperties.Name="{loc:Localize Bulk_BtnSelectAll}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{loc:Localize AddEdit_LblName}"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{loc:Localize AddEdit_LblSubject}"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{loc:Localize AddEdit_LblType}"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>


                <ListBox x:Name="DocumentList" Grid.Row="1"
                         AutomationProperties.AutomationId="AddToCollection_DocumentList"
                         AutomationProperties.Name="{loc:Localize AddEdit_LblName}"
                         Background="Transparent"
                         SelectionMode="Single"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="0,0,0,1" Padding="{StaticResource PaddingNavItem}">
                                <Grid ColumnDefinitions="32,*,130,80">
                                    <CheckBox Grid.Column="0"
                                              AutomationProperties.Name="{Binding Document.Name}"
                                              IsChecked="{Binding IsSelected}"
                                              IsCheckedChanged="OnItemSelectionChanged"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Document.Name}"
                                                   FontSize="{StaticResource FontSizeMd}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Document.Author}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   IsVisible="{Binding HasAuthor}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Document.Subject}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="3" VerticalAlignment="Center"
                                            Background="{StaticResource StatBlueBg}"
                                            CornerRadius="{StaticResource RadiusXs}" Padding="{StaticResource PaddingBadge}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Document.Type}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>


        <Border Grid.Row="3" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="{StaticResource PaddingCardLg}" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Bulk_Selected}" FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}"
                            Padding="{StaticResource PaddingBadgeMd}" MinWidth="22">
                        <TextBlock x:Name="SelectedCountBadge"
                                   AutomationProperties.AutomationId="AddToCollection_SelectedCount"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="0"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:Localize Bulk_Documents}" FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

  
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="ConfirmButton"
                            AutomationProperties.AutomationId="AddToCollection_Confirm"
                            AutomationProperties.Name="{loc:Localize AddToCollection_BtnAdd}"
                            Content="{loc:Localize AddToCollection_BtnAdd}"
                            Classes="primary" Padding="{StaticResource PaddingBtnLg}" FontSize="{StaticResource FontSizeMd}"
                            IsDefault="True" IsEnabled="False"/>
                    <Button x:Name="CancelButton"
                            AutomationProperties.AutomationId="AddToCollection_Cancel"
                            AutomationProperties.Name="{loc:Localize AddEdit_BtnCancel}"
                            Content="{loc:Localize AddEdit_BtnCancel}"
                            Classes="secondary" Padding="{StaticResource PaddingBtnLg}" FontSize="{StaticResource FontSizeMd}"
                            IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
