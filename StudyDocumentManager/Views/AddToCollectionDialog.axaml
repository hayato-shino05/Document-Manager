<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudyDocumentManager.Views.AddToCollectionDialog"
        Title="Thêm tài liệu vào bộ sưu tập"
        Width="680" Height="520"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource ContentBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingCard}">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleLabel" Text="Thêm tài liệu"
                           FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="SubtitleLabel" Text="Chọn một hoặc nhiều tài liệu để thêm vào bộ sưu tập"
                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Padding="{StaticResource PaddingStatCard}" Background="{StaticResource ContentBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Watermark="Tìm kiếm theo tên, danh mục, loại..."
                         Height="30" VerticalContentAlignment="Center"
                         Padding="12,4,10,4"
                         FontSize="{StaticResource FontSizeMd}">
                    <TextBox.InnerLeftContent>
                        <Image Source="{StaticResource IconSearch}" 
                               Width="14" Height="14" 
                               Margin="10,0,0,0" 
                               Opacity="0.6"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock x:Name="CountLabel" Grid.Column="1"
                           VerticalAlignment="Center" Margin="10,0,4,0"
                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"
                           Text="0 kết quả"/>
                <Button x:Name="SelectAllBtn" Grid.Column="2"
                        Content="Chọn tất cả" FontSize="{StaticResource FontSizeSm}"
                        Padding="{StaticResource PaddingChip}" VerticalAlignment="Center"
                        Classes="secondary" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Document list -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}"
                Margin="12,8,12,0">
            <Grid RowDefinitions="Auto,*">

                <!-- Column headers -->
                <Border Grid.Row="0" Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                        Padding="{StaticResource PaddingMd}">
                    <Grid ColumnDefinitions="32,*,130,80">
                        <CheckBox x:Name="HeaderCheckBox" Grid.Column="0"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tên tài liệu"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Danh mục"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Loại"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Items -->
                <ListBox x:Name="DocumentList" Grid.Row="1"
                         Background="Transparent"
                         SelectionMode="Single"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="0,0,0,1" Padding="{StaticResource PaddingNavItem}">
                                <Grid ColumnDefinitions="32,*,130,80">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Document.Ten}"
                                                   FontSize="{StaticResource FontSizeMd}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Document.TacGia}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   IsVisible="{Binding HasAuthor}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Document.MonHoc}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="3" VerticalAlignment="Center"
                                            Background="{StaticResource StatBlueBg}"
                                            CornerRadius="{StaticResource RadiusXs}" Padding="{StaticResource PaddingBadge}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Document.Loai}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Medium"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="{StaticResource PaddingCardLg}" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="Đã chọn:" FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="{StaticResource RadiusPill}"
                            Padding="{StaticResource PaddingBadgeMd}" MinWidth="22">
                        <TextBlock x:Name="SelectedCountBadge" Text="0"
                                   FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="tài liệu" FontSize="{StaticResource FontSizeMd}"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Confirm first, then Cancel — consistent button order -->  
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button x:Name="ConfirmButton" Content="Thêm vào bộ sưu tập"
                            Classes="primary" Padding="{StaticResource PaddingBtnLg}" FontSize="{StaticResource FontSizeMd}"
                            IsDefault="True" IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Hủy"
                            Classes="secondary" Padding="{StaticResource PaddingBtnLg}" FontSize="{StaticResource FontSizeMd}"
                            IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
