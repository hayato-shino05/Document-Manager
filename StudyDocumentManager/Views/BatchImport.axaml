<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
        xmlns:loc="using:StudyDocumentManager.Markup"
                     x:Class="StudyDocumentManager.Views.BatchImport"
             x:DataType="vm:BatchImportModel"
             AutomationProperties.AutomationId="Screen_BatchImport">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                <Image Source="{StaticResource IconImport}" Width="18" Height="18"/>
                <TextBlock Text="{loc:Localize BatchImport_Title}"
                           AutomationProperties.AutomationId="Screen_BatchImport"
                           FontSize="{StaticResource FontSizeXl}"
                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    Padding="{StaticResource PaddingStatCard}" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <DockPanel>
                        <TextBlock Text="{loc:Localize BatchImport_LblFolder}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Classes="secondary"
                                AutomationProperties.AutomationId="BatchImport_BrowseFolder"
                                AutomationProperties.Name="{loc:Localize BatchImport_BtnBrowse}"
                                Command="{Binding BrowseFolderCommand}" Padding="{StaticResource PaddingBtnMd}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{StaticResource IconCategory}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize BatchImport_BtnBrowse}" FontSize="{StaticResource FontSizeSm}"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Classes="primary"
                                AutomationProperties.AutomationId="BatchImport_ScanFolder"
                                AutomationProperties.Name="{loc:Localize BatchImport_BtnScan}"
                                Command="{Binding ScanFolderCommand}" Padding="{StaticResource PaddingBtnMd}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{StaticResource IconScanWhite}" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Localize BatchImport_BtnScan}" FontSize="{StaticResource FontSizeSm}"/>
                            </StackPanel>
                        </Button>
                        <TextBox AutomationProperties.AutomationId="BatchImport_FolderPath"
                                 AutomationProperties.Name="{loc:Localize BatchImport_LblFolder}"
                                 Text="{Binding FolderPath, Mode=TwoWay}" FontSize="{StaticResource FontSizeMd}"
                                 Height="30"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Localize BatchImport_LblDefaultSubject}" FontSize="{StaticResource FontSizeMd}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                        <TextBox AutomationProperties.AutomationId="BatchImport_DefaultSubject"
                                 AutomationProperties.Name="{loc:Localize BatchImport_LblDefaultSubject}"
                                 Text="{Binding DefaultSubject, Mode=TwoWay}" FontSize="{StaticResource FontSizeMd}"
                                 Height="30" Width="250" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock AutomationProperties.AutomationId="BatchImport_Status"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding ImportStatusMessage}"
                           IsVisible="{Binding ImportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource TextSecondary}"/>
                <TextBlock AutomationProperties.AutomationId="BatchImport_Error"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding ImportErrorMessage}"
                           IsVisible="{Binding ImportErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{StaticResource DangerBrush}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_SelectAll"
                        AutomationProperties.Name="{loc:Localize Bulk_BtnSelectAll}"
                        Command="{Binding SelectAllCommand}" Padding="{StaticResource PaddingBtnMd}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="{StaticResource IconCheckNeutral}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize Bulk_BtnSelectAll}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_DeselectAll"
                        AutomationProperties.Name="{loc:Localize Bulk_BtnDeselectAll}"
                        Command="{Binding DeselectAllCommand}" Padding="{StaticResource PaddingBtnMd}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconClose}" Width="14" Height="14"/>
                        <TextBlock Text="{loc:Localize Bulk_BtnDeselectAll}" FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" AutomationProperties.AutomationId="BatchImport_Import"
                        AutomationProperties.Name="{loc:Localize BatchImport_BtnImport}"
                        Command="{Binding ImportCommand}" Padding="{StaticResource PaddingBtnLg}"
                        IsEnabled="{Binding !IsImporting}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconImportWhite}" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Localize BatchImport_BtnImport}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_Cancel"
                        AutomationProperties.Name="{loc:Localize AddEdit_BtnCancel}"
                        Command="{Binding CancelCommand}" Padding="{StaticResource PaddingMd}">
                    <TextBlock Text="{loc:Localize AddEdit_BtnCancel}" FontSize="{StaticResource FontSizeMd}"/>
                </Button>
            </StackPanel>

            <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                <Panel>
                    <DataGrid AutomationProperties.AutomationId="BatchImport_FileGrid"
                              AutomationProperties.Name="{loc:Localize BatchImport_ColFileName}"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTextColumn Header="{loc:Localize BatchImport_ColFileName}" Binding="{Binding FileName}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="{loc:Localize AddEdit_LblType}" Binding="{Binding FileType}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Localize BatchImport_ColSize}" Binding="{Binding FileSizeMB, StringFormat=\{0:F2\}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Localize BatchImport_ColPath}" Binding="{Binding FilePath}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel IsVisible="{Binding !Files.Count}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <Image Source="{StaticResource IconCategory}" Width="36" Height="36"
                               HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="{loc:Localize BatchImport_EmptyState}" FontSize="{StaticResource FontSizeLg}"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
