<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             xmlns:loc="using:StudyDocumentManager.Markup"
             x:Class="StudyDocumentManager.Views.BatchImport"
             x:DataType="vm:BatchImportModel"
             AutomationProperties.AutomationId="Screen_BatchImport"
             AutomationProperties.AccessibilityView="Control">

    <Border Background="{DynamicResource ContentBackground}" Padding="{DynamicResource PaddingPage}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                <Image Source="{DynamicResource IconImport}" Width="18" Height="18"/>
                <TextBlock Text="{loc:Localize BatchImport_Title}"
                           AutomationProperties.AutomationId="Title_BatchImport"
                           FontSize="{DynamicResource FontSizeXl}"
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    Padding="{DynamicResource PaddingStatCard}" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Localize BatchImport_LblFolder}" FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="BatchImport_FolderPath"
                                 AutomationProperties.Name="{loc:Localize BatchImport_LblFolder}"
                                 Text="{Binding FolderPath, Mode=TwoWay}" FontSize="{DynamicResource FontSizeMd}"
                                 Height="32" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="secondary"
                                AutomationProperties.AutomationId="BatchImport_BrowseFolder"
                                AutomationProperties.Name="{loc:Localize BatchImport_BtnBrowse}"
                                Command="{Binding BrowseFolderCommand}" Padding="{DynamicResource PaddingBtnMd}" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{DynamicResource IconOpenFile}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize BatchImport_BtnBrowse}" FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="primary"
                                AutomationProperties.AutomationId="BatchImport_ScanFolder"
                                AutomationProperties.Name="{loc:Localize BatchImport_BtnScan}"
                                Command="{Binding ScanFolderCommand}" Padding="{DynamicResource PaddingBtnMd}" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{DynamicResource IconScanWhite}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize BatchImport_BtnScan}" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DockPanel>
                        <TextBlock Text="{loc:Localize BatchImport_LblDefaultSubject}" FontSize="{DynamicResource FontSizeMd}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                        <TextBox AutomationProperties.AutomationId="BatchImport_DefaultSubject"
                                 AutomationProperties.Name="{loc:Localize BatchImport_LblDefaultSubject}"
                                 Text="{Binding DefaultSubject, Mode=TwoWay}" FontSize="{DynamicResource FontSizeMd}"
                                 Height="30" Width="250" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding IsImporting}"
                            AutomationProperties.AutomationId="BatchImport_Progress">
                    <TextBlock Text="{loc:Localize BatchImport_ProgressLabel}"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding ProcessedCount}"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="/"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalCount}"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBlock AutomationProperties.AutomationId="BatchImport_Status"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding ImportStatusMessage}"
                           IsVisible="{Binding ImportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="{DynamicResource FontSizeSm}"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock AutomationProperties.AutomationId="BatchImport_Error"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding ImportErrorMessage}"
                           IsVisible="{Binding ImportErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="{DynamicResource FontSizeSm}"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>

            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                       HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_SelectAll"
                        AutomationProperties.Name="{loc:Localize Bulk_BtnSelectAll}"
                        Command="{Binding SelectAllCommand}" Padding="{DynamicResource PaddingBtnMd}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Image Source="{DynamicResource IconCheckNeutral}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize Bulk_BtnSelectAll}" FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_DeselectAll"
                        AutomationProperties.Name="{loc:Localize Bulk_BtnDeselectAll}"
                        Command="{Binding DeselectAllCommand}" Padding="{DynamicResource PaddingBtnMd}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{DynamicResource IconClose}" Width="14" Height="14"/>
                        <TextBlock Text="{loc:Localize Bulk_BtnDeselectAll}" FontSize="{DynamicResource FontSizeSm}"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_RetryFailed"
                        AutomationProperties.Name="{loc:Localize BatchImport_BtnRetryFailed}"
                        Command="{Binding RetryFailedCommand}" Padding="{DynamicResource PaddingBtnMd}"
                        IsVisible="{Binding HasFailedItems}"
                        IsEnabled="{Binding !IsImporting}" Margin="0,0,8,0">
                    <TextBlock Text="{loc:Localize BatchImport_BtnRetryFailed}" FontSize="{DynamicResource FontSizeSm}"/>
                </Button>
                <Button Classes="primary" AutomationProperties.AutomationId="BatchImport_Import"
                        AutomationProperties.Name="{loc:Localize BatchImport_BtnImport}"
                        Command="{Binding ImportCommand}" Padding="{DynamicResource PaddingBtnLg}"
                        IsEnabled="{Binding !IsImporting}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{DynamicResource IconImportWhite}" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Localize BatchImport_BtnImport}" FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" AutomationProperties.AutomationId="BatchImport_Cancel"
                        AutomationProperties.Name="{loc:Localize AddEdit_BtnCancel}"
                        Command="{Binding CancelCommand}" Padding="{DynamicResource PaddingMd}">
                        <TextBlock Text="{loc:Localize AddEdit_BtnCancel}" FontSize="{DynamicResource FontSizeMd}"/>
                </Button>
            </WrapPanel>

            <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                <Panel>
                    <DataGrid AutomationProperties.AutomationId="BatchImport_FileGrid"
                              AutomationProperties.Name="{loc:Localize BatchImport_ColFileName}"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTemplateColumn Header="{loc:Localize BatchImport_ColFileName}" Width="*" MinWidth="200" SortMemberPath="FileName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileImportItem">
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="8,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Localize AddEdit_LblType}" Binding="{Binding FileType}" Width="80" MinWidth="80"/>
                            <DataGridTextColumn Header="{loc:Localize BatchImport_ColSize}" Binding="{Binding FileSizeMB, StringFormat=\{0:F2\}}" Width="110" MinWidth="100"/>
                            <DataGridTemplateColumn Header="{loc:Localize BatchImport_ColPath}" Width="300" MinWidth="200" SortMemberPath="FilePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileImportItem">
                                        <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Localize BatchImport_ColFailure}" Width="220" MinWidth="150" SortMemberPath="FailureReason">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:FileImportItem">
                                        <TextBlock Text="{Binding FailureReason}" VerticalAlignment="Center" Margin="8,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FailureReason}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel IsVisible="{Binding !Files.Count}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
                        <Image Source="{DynamicResource IconCategory}" Width="44" Height="44"
                               HorizontalAlignment="Center" Opacity="0.35"/>
                        <TextBlock Text="{loc:Localize BatchImport_EmptyState}" FontSize="{DynamicResource FontSizeLg}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
