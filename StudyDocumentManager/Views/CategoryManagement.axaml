<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             x:Class="StudyDocumentManager.Views.CategoryManagement"
             x:DataType="vm:CategoryManagementModel">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconCategory}" Width="18" Height="18"/>
                    <TextBlock Text="Qu?n l� Danh m?c" FontSize="{StaticResource FontSizeXl}"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Info hint -->
            <Border DockPanel.Dock="Top" Background="{StaticResource StatBlueBg}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource PaddingSidebar}" Margin="0,0,0,12"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{StaticResource IconInfo}" Width="13" Height="13"/>
                    <TextBlock Text="B?n c� th? Th�m, �?i t�n ho?c X�a danh m?c/lo?i t?i d�y. X�a s? chuy?n t�i li?u li�n quan v�o th�ng r�c."
                               FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Two-column layout -->
            <Grid ColumnDefinitions="*,20,*">

                <!-- Left: Danh m?c -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="{StaticResource PaddingMd}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconCategory}" Width="13" Height="13"/>
                                    <TextBlock Text="Danh m?c (M�n h?c)" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding AddSubjectCommand}" Padding="{StaticResource PaddingSm}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAddWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="Th�m" FontSize="{StaticResource FontSizeSm}" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding RenameSubjectCommand}" Padding="{StaticResource PaddingSm}"
                                            IsEnabled="{Binding SelectedSubject, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Ch?n m?t m?c trong danh s�ch d? d?i t�n">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconEdit}" Width="11" Height="11"/>
                                            <TextBlock Text="�?i t�n" FontSize="{StaticResource FontSizeSm}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding DeleteSubjectCommand}" Padding="{StaticResource PaddingSm}"
                                            IsEnabled="{Binding SelectedSubject, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Ch?n m?t ho?c nhi?u m?c d? x�a (c� th? ch?n nhi?u b?ng Ctrl+Click)">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconDeleteWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="X�a" FontSize="{StaticResource FontSizeSm}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Subjects}"
                                 SelectedItem="{Binding SelectedSubject}"
                                 SelectionMode="Multiple"
                                 SelectedItems="{Binding SelectedSubjects}"
                                 Padding="{StaticResource PaddingIcon}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,8">
                                        <Image Source="{StaticResource IconCategory}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Display}" FontSize="{StaticResource FontSizeMd}"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right: Lo?i t�i li?u -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="{StaticResource PaddingMd}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconDocPage}" Width="13" Height="13"/>
                                    <TextBlock Text="Lo?i t�i li?u" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding AddTypeCommand}" Padding="{StaticResource PaddingSm}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAddWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="Th�m" FontSize="{StaticResource FontSizeSm}" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding RenameTypeCommand}" Padding="{StaticResource PaddingSm}"
                                            IsEnabled="{Binding SelectedType, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Ch?n m?t m?c trong danh s�ch d? d?i t�n">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconEdit}" Width="11" Height="11"/>
                                            <TextBlock Text="�?i t�n" FontSize="{StaticResource FontSizeSm}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding DeleteTypeCommand}" Padding="{StaticResource PaddingSm}"
                                            IsEnabled="{Binding SelectedType, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            ToolTip.Tip="Ch?n m?t ho?c nhi?u m?c d? x�a (c� th? ch?n nhi?u b?ng Ctrl+Click)">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconDeleteWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="X�a" FontSize="{StaticResource FontSizeSm}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Types}"
                                 SelectedItem="{Binding SelectedType}"
                                 SelectionMode="Multiple"
                                 SelectedItems="{Binding SelectedTypes}"
                                 Padding="{StaticResource PaddingIcon}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,8">
                                        <Image Source="{StaticResource IconDocPage}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Display}" FontSize="{StaticResource FontSizeMd}"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
