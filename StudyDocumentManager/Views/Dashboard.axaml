<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             xmlns:items="using:StudyDocumentManager.Models.Items"
             xmlns:conv="using:StudyDocumentManager.Converters"
             xmlns:core="using:StudyDocumentManager.Core.Entities"
        xmlns:loc="using:StudyDocumentManager.Markup"
                     x:Class="StudyDocumentManager.Views.Dashboard"
             x:DataType="vm:DashboardModel">

    <UserControl.Resources>
        <conv:DeadlineBrushConverter x:Key="DeadlineBrushConverter"/>
        <conv:DeadlineTextConverter x:Key="DeadlineTextConverter"/>
    </UserControl.Resources>

    <DockPanel>

        <!-- ═══ SEARCH BAR ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingRow}">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Left: Search + Dropdown filters -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconSearch}" Width="13" Height="13"
                           VerticalAlignment="Center" Opacity="0.5"/>
                    <TextBox Width="260" Height="{StaticResource HeightControl}" FontSize="{StaticResource FontSizeMd}"
                             Watermark="{loc:Localize Dashboard_SearchPlaceholder}"
                             Text="{Binding SearchKeyword, Mode=TwoWay}"
                             VerticalContentAlignment="Center"/>
                    <Button Classes="primary" Command="{Binding SearchCommand}"
                            Padding="{StaticResource PaddingBtn}" Height="{StaticResource HeightControl}" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Localize Dashboard_TipSearch}">
                        <TextBlock Text="{loc:Localize Dashboard_BtnSearch}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource CardBorder}" Margin="4,0"/>

                    <TextBlock Text="{loc:Localize Dashboard_LblCategory}" FontSize="{StaticResource FontSizeMd}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox Name="cboSubject" Width="140" FontSize="{StaticResource FontSizeMd}"
                              Height="{StaticResource HeightControl}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:DashboardFilterLabelConverter.Instance}, ConverterParameter=Filter_AllSubjects}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{loc:Localize Dashboard_LblType}" FontSize="{StaticResource FontSizeMd}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"/>
                    <ComboBox Name="cboType" Width="120" FontSize="{StaticResource FontSizeMd}"
                              Height="{StaticResource HeightControl}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:DashboardFilterLabelConverter.Instance}, ConverterParameter=Filter_AllTypes}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right: Toggle advanced filter button -->
                <Button Grid.Column="1" Classes="secondary"
                        Padding="{StaticResource PaddingBtnSm}" Height="{StaticResource HeightControl}" VerticalAlignment="Center"
                        Command="{Binding ToggleAdvancedFilterCommand}"
                        ToolTip.Tip="{loc:Localize Dashboard_TipAdvancedFilter}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                        <Image Source="{StaticResource IconFilter}" Width="12" Height="12"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize Dashboard_BtnAdvancedFilter}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"/>
                        <Image Width="9" Height="9" VerticalAlignment="Center"
                               IsVisible="{Binding IsAdvancedFilterVisible}"
                               Source="{StaticResource IconChevronUp}"/>
                        <Image Width="9" Height="9" VerticalAlignment="Center"
                               IsVisible="{Binding !IsAdvancedFilterVisible}"
                               Source="{StaticResource IconChevronDown}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ ADVANCED FILTER PANEL (Collapsible) ═══ -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsAdvancedFilterVisible}"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="{StaticResource PaddingCard}">
            <StackPanel Spacing="12">

                <!-- Filter Groups Row -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,*,Auto">

                    <!-- ── Group 1: Khoảng thời gian ── -->
                    <Border CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingStatCard}" Margin="0,0,8,0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding IsDateFilterEnabled}"
                                          VerticalAlignment="Center"/>
                                <Image Source="{StaticResource IconCalendar}" Width="14" Height="14"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Dashboard_LblDateRange}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*,Auto,*" IsEnabled="{Binding IsDateFilterEnabled}">
                                <TextBlock Text="{loc:Localize Dashboard_LblFrom}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                                <DatePicker Grid.Column="1" FontSize="{StaticResource FontSizeSm}" Height="30"
                                            SelectedDate="{Binding FilterFromDate}"
                                            HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{loc:Localize Dashboard_LblTo}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" Margin="10,0,6,0"/>
                                <DatePicker Grid.Column="3" FontSize="{StaticResource FontSizeSm}" Height="30"
                                            SelectedDate="{Binding FilterToDate}"
                                            HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Group 2: Dung lượng + Quan trọng ── -->
                    <Border Grid.Column="1" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingStatCard}" Margin="0,0,8,0">
                        <StackPanel Spacing="8">
                            <!-- Size Filter -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding IsSizeFilterEnabled}"
                                          VerticalAlignment="Center"/>
                                <Image Source="{StaticResource IconSize}" Width="14" Height="14"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Dashboard_LblFileSize}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsEnabled="{Binding IsSizeFilterEnabled}">
                                <TextBlock Text="{loc:Localize Dashboard_LblSizeFrom}" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <NumericUpDown Width="80" FontSize="{StaticResource FontSizeSm}" Height="30"
                                               Value="{Binding FilterMinSize}"
                                               Minimum="0" FormatString="F1"/>
                                <TextBlock Text="→" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}"/>
                                <NumericUpDown Width="80" FontSize="{StaticResource FontSizeSm}" Height="30"
                                               Value="{Binding FilterMaxSize}"
                                               Minimum="0" FormatString="F1"/>
                                <TextBlock Text="MB" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Important toggle -->
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                                    Padding="0,6,0,0">
                                <CheckBox IsChecked="{Binding IsImportantOnly}"
                                          VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Image Source="{StaticResource IconStar}" Width="13" Height="13"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Localize Dashboard_LblImportantOnly}" FontSize="{StaticResource FontSizeSm}"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ── Group 3: Action Buttons ── -->
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center"
                                MinWidth="110">
                        <Button Classes="primary" Command="{Binding ApplyAdvancedFilterCommand}"
                                Padding="16,7" HorizontalAlignment="Stretch"
                                ToolTip.Tip="{loc:Localize Dashboard_TipApplyFilter}">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Image Source="{StaticResource IconCheck}" Width="12" Height="12"/>
                                <TextBlock Text="{loc:Localize Dashboard_BtnApplyFilter}" FontSize="{StaticResource FontSizeMd}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding ClearAdvancedFilterCommand}"
                                Padding="16,7" HorizontalAlignment="Stretch"
                                ToolTip.Tip="{loc:Localize Dashboard_TipClearFilter}">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Image Source="{StaticResource IconClose}" Width="10" Height="10"/>
                                <TextBlock Text="{loc:Localize Dashboard_BtnClearFilter}" FontSize="{StaticResource FontSizeSm}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- ═══ MAIN: TreeView (left) + DataGrid (right) ═══ -->
        <Grid ColumnDefinitions="190,Auto,*">

            <!-- ── LEFT: Category Tree ── -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                            Padding="{StaticResource PaddingNavItem}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Image Source="{StaticResource IconCategory}" Width="15" Height="15"/>
                            <TextBlock Text="{loc:Localize Dashboard_LblClassification}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CategoryTreeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="items:CategoryTreeItem">
                                    <Panel>
                                        <!-- Section headers: muted uppercase label, NOT clickable -->
                                        <Border IsVisible="{Binding IsHeader}"
                                                Padding="10,10,10,3" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource FontSizeSm}" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Opacity="0.8"/>
                                        </Border>
                                        <!-- Normal nav items: clickable buttons -->
                                        <Button IsVisible="{Binding !IsHeader}"
                                                Classes="nav-item"
                                                Padding="{StaticResource PaddingSidebar}"
                                                Margin="{Binding IndentMargin}"
                                                Command="{Binding $parent[ItemsControl].DataContext.FilterByCategoryCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{loc:Localize Dashboard_TipCategoryItem}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Image Source="{Binding ResolvedIconSource}" Width="15" Height="15"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayText}" FontSize="{StaticResource FontSizeMd}"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                            </StackPanel>
                                        </Button>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Column="1" Width="3" Background="Transparent"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── RIGHT: DataGrid + Preview ── -->
            <Border Grid.Column="2" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto,Auto">

                    <!-- ═══ STAT CARDS ═══ -->
                    <Border Background="{StaticResource SidebarBackground}"
                            Padding="{StaticResource PaddingStatCard}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid ColumnDefinitions="*,*,*,*,*,*">

                            <!-- Card 1: Total -->
                            <Border CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource GradientStatBlue}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}" Margin="0,0,4,0">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconAllDocs}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatTotal}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Subjects -->
                            <Border Grid.Column="1" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource GradientStatTeal}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}" Margin="0,0,4,0">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconCategory}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatCategories}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubjectCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Important -->
                            <Border Grid.Column="2" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource GradientStatAmber}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}" Margin="0,0,4,0">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconStar}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatImportant}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ImportantCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Overdue -->
                            <Border Grid.Column="3" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource GradientStatRed}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}" Margin="0,0,4,0">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconClock}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatOverdue}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OverdueCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: No File -->
                            <Border Grid.Column="4" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}" Margin="0,0,4,0">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconWarning}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatNoFile}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NoFileCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Recycle Bin -->
                            <Border Grid.Column="5" CornerRadius="{StaticResource RadiusMd}" Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    Padding="{StaticResource PaddingNavItem}">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <Image Source="{StaticResource IconRecycle}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_StatRecycleBin}" FontSize="{StaticResource FontSizeXs}"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RecycleBinCount}" FontSize="{StaticResource FontSizeXl}"
                                               FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- ═══ DATA GRID ═══ -->
                    <Border Grid.Row="1" ClipToBounds="True">
                        <Panel>
                        <DataGrid Name="dgvDocuments"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  IsReadOnly="True">
                            <!-- Context Menu -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <!-- Primary actions -->
                                    <MenuItem Header="{loc:Localize Dashboard_CtxOpenFile}"
                                              Command="{Binding $parent[DataGrid].DataContext.OpenFileCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconDocPage}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxEditDoc}"
                                              Command="{Binding $parent[DataGrid].DataContext.EditDocumentCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconEdit}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxChangeCategory}"
                                              Command="{Binding $parent[DataGrid].DataContext.ChangeCategoryCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconCategory}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxDeleteToTrash}"
                                              Command="{Binding $parent[DataGrid].DataContext.DeleteDocumentCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconDelete}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <!-- Copy &amp; Open -->
                                    <MenuItem Header="{loc:Localize Dashboard_CtxCopyName}"
                                              Command="{Binding $parent[DataGrid].DataContext.CopyNameCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconClipboard}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxCopyPath}"
                                              Command="{Binding $parent[DataGrid].DataContext.CopyPathCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconExport}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxOpenFolder}"
                                              Command="{Binding $parent[DataGrid].DataContext.OpenFolderCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconOpenFile}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <!-- Quick-edit hidden fields -->
                                    <MenuItem Header="{loc:Localize Dashboard_CtxEditTags}"
                                              Command="{Binding $parent[DataGrid].DataContext.QuickEditTagsCommand}"
                                              ToolTip.Tip="{loc:Localize Dashboard_TipEditTags}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconTag}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxEditNotes}"
                                              Command="{Binding $parent[DataGrid].DataContext.QuickEditGhiChuCommand}"
                                              ToolTip.Tip="{loc:Localize Dashboard_TipEditNotes}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconNote}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <!-- Mark &amp; manage -->
                                    <MenuItem Header="{loc:Localize Dashboard_CtxMarkImportant}"
                                              Command="{Binding $parent[DataGrid].DataContext.ToggleImportantCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconStar}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxPersonalNote}"
                                              Command="{Binding $parent[DataGrid].DataContext.OpenPersonalNoteCommand}"
                                              ToolTip.Tip="{loc:Localize Dashboard_TipPersonalNote}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconBook}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxAddToCollection}"
                                              Command="{Binding $parent[DataGrid].DataContext.AddToCollectionCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconAdd}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{loc:Localize Dashboard_CtxRelatedDocs}"
                                              Command="{Binding $parent[DataGrid].DataContext.OpenRelatedDocumentsCommand}">
                                        <MenuItem.Icon><Image Source="{StaticResource IconRelatedDocs}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Localize Dashboard_ColDocName}" Width="*" MinWidth="200" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:StudyDocument}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                                                <Image Source="{Binding Type, Converter={x:Static conv:DocumentTypeIconConverter.Instance}}"
                                                       Width="16" Height="16" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Localize Dashboard_ColSubject}" Binding="{Binding Subject, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Localize Dashboard_ColType}" Binding="{Binding Type, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="{loc:Localize Dashboard_ColDate}"
                                    Binding="{Binding CreatedAt, Mode=OneWay, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="{loc:Localize Dashboard_ColSize}"
                                    Binding="{Binding FileSize, Mode=OneWay, StringFormat=\{0:F2\}}" Width="80"/>
                                <DataGridTemplateColumn Header="★" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:StudyDocument}">
                                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding $parent[DataGrid].DataContext.ToggleImportantInlineCommand}"
                                                    CommandParameter="{Binding}">
                                                <Panel>
                                                    <Image Source="{StaticResource IconStar}" Width="14" Height="14"
                                                           IsVisible="{Binding IsImportant}"/>
                                                    <TextBlock Text="☆" FontSize="{StaticResource FontSizeLg}" Foreground="{StaticResource TextMuted}"
                                                               IsVisible="{Binding !IsImportant}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Localize Dashboard_ColDeadline}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type core:StudyDocument}">
                                            <Border Background="{Binding Deadline, Converter={StaticResource DeadlineBrushConverter}}"
                                                    CornerRadius="{StaticResource RadiusXs}" Padding="{StaticResource PaddingXs}" Margin="1">
                                                <TextBlock Text="{Binding Deadline, StringFormat=\{0:dd/MM/yyyy\}}"
                                                           Foreground="{Binding Deadline, Converter={StaticResource DeadlineTextConverter}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeSm}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Classes="empty-state" IsVisible="{Binding IsLoading}">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                            <TextBlock Classes="empty-state-text" Text="{loc:Localize Status_Loading}"/>
                        </StackPanel>
                        <StackPanel Classes="empty-state" IsVisible="{Binding HasLoadError}">
                            <Image Classes="empty-state-icon" Source="{StaticResource IconWarning}"/>
                            <TextBlock Classes="empty-state-text" Text="{Binding StateMessage}"/>
                            <Button Classes="secondary" Command="{Binding RefreshCommand}"
                                    Padding="{StaticResource PaddingBtnSm}"
                                    Content="{loc:Localize Dashboard_BtnRetry}"/>
                        </StackPanel>
                        <StackPanel Classes="empty-state" IsVisible="{Binding IsEmptyState}">
                            <Image Classes="empty-state-icon" Source="{StaticResource IconDocPage}"/>
                            <TextBlock Classes="empty-state-text" Text="{Binding StateMessage}"/>
                        </StackPanel>
                        </Panel>
                    </Border>

                    <!-- ═══ DOCUMENT PREVIEW PANEL (collapsible, like WinForms) ═══ -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding SelectedDocument, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Background="{StaticResource SidebarBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                            Padding="{StaticResource PaddingCardLg}" MaxHeight="140">
                        <Grid ColumnDefinitions="Auto,*">

                            <!-- Image preview (show for image files) -->
                            <Border CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                                    Width="100" Height="100" Margin="0,0,16,0"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <Panel>
                                    <!-- Document type icon -->
                                    <Image Source="{StaticResource IconDocPage}" Width="40" Height="40"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.6"/>
                                </Panel>
                            </Border>

                            <!-- Metadata -->
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDocument.Name}" FontSize="{StaticResource FontSizeLg}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Image Source="{StaticResource IconCategory}" Width="11" Height="11"/>
                                        <TextBlock Text="{Binding SelectedDocument.Subject}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Image Source="{StaticResource IconDocPage}" Width="11" Height="11"/>
                                        <TextBlock Text="{Binding SelectedDocument.Type}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                IsVisible="{Binding SelectedDocument.IsImportant}">
                                        <Image Source="{StaticResource IconStar}" Width="11" Height="11"/>
                                        <TextBlock Text="{loc:Localize Dashboard_PreviewImportant}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource WarningBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconOpenFile}" Width="10" Height="10"/>
                                    <TextBlock Text="{Binding SelectedDocument.FilePath}" FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Image Source="{StaticResource IconCalendar}" Width="10" Height="10"/>
                                        <TextBlock Text="{Binding SelectedDocument.CreatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"
                                                   FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                IsVisible="{Binding SelectedDocument.FileSize, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{StaticResource IconHDD}" Width="10" Height="10"/>
                                        <TextBlock Text="{Binding SelectedDocument.FileSize, StringFormat=\{0:F2\} MB}"
                                                   FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                IsVisible="{Binding SelectedDocument.Deadline, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{StaticResource IconClock}" Width="10" Height="10"/>
                                        <TextBlock Text="{Binding SelectedDocument.Deadline, StringFormat={loc:Localize Dashboard_PreviewDeadline}}"
                                                   FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3"
                                            IsVisible="{Binding SelectedDocument.Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Image Source="{StaticResource IconTag}" Width="10" Height="10"/>
                                    <TextBlock Text="{Binding SelectedDocument.Tags}" FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Bar -->
                    <Border Grid.Row="3" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                            Padding="{StaticResource PaddingMd}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSizeSm}"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>

                            <!-- Quick action buttons -->
                            <Button Grid.Column="1" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipRefresh}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconRefresh}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Dashboard_BtnRefresh}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding ShowUpcomingDeadlinesCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipUpcoming}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconClock}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Dashboard_BtnUpcoming}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding ShowOverdueCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipOverdue}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconWarning}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Dashboard_BtnOverdue}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding CopyPathCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipCopyPath}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconClipboard}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Dashboard_CtxCopyPath}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding OpenFolderCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipOpenFolder}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconCategory}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Dashboard_BtnOpenFolder}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Classes="secondary" Padding="{StaticResource PaddingChip}"
                                    Command="{Binding ShowAboutCommand}"
                                    Margin="4,0" Height="24" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize Dashboard_TipAbout}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Image Source="{StaticResource IconInfo}" Width="10" Height="10"/>
                                    <TextBlock Text="{loc:Localize Menu_About}" FontSize="{StaticResource FontSizeXs}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </DockPanel>

</UserControl>
