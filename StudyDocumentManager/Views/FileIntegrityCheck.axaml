<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             x:Class="StudyDocumentManager.Views.FileIntegrityCheck"
             x:DataType="vm:FileIntegrityCheckModel">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconShield}" Width="20" Height="20"/>
                    <TextBlock Text="{Binding [FileIntegrity_Title], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeXl}"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Classes="primary" Command="{Binding RunIntegrityCheckCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{StaticResource IconSearch}" Width="12" Height="12"/>
                            <TextBlock Text="{Binding [FileIntegrity_BtnScan], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeSm}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource StatBlueBg}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource PaddingSidebar}" Margin="0,0,0,12"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{StaticResource IconInfo}" Width="13" Height="13"/>
                    <TextBlock Text="{Binding [FileIntegrity_InfoHint], Source={StaticResource Loc}}"
                               FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" IsVisible="{Binding IsChecking}" Margin="0,0,0,10">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="300"/>
                    <TextBlock Text="{Binding [FileIntegrity_Checking], Source={StaticResource Loc}}"
                               FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid RowDefinitions="Auto,*" Margin="0,0,0,0">

                <Border IsVisible="{Binding HasResults}" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="{StaticResource StatGreenBg}" CornerRadius="6" Padding="16,10" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCheck}" Width="14" Height="14"/>
                                <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource StatGreenFg}">
                                    <Run Text="{Binding [FileIntegrity_StatValid], Source={StaticResource Loc}}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding ValidCount}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource StatRedBg}" CornerRadius="6" Padding="16,10" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconWarning}" Width="14" Height="14"/>
                                <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource StatRedFg}">
                                    <Run Text="{Binding [FileIntegrity_StatMissing], Source={StaticResource Loc}}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding MissingCount}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource StatYellowBg}" CornerRadius="6" Padding="16,10" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconWarning}" Width="14" Height="14"/>
                                <TextBlock FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource StatYellowFg}">
                                    <Run Text="{Binding [FileIntegrity_StatCorrupted], Source={StaticResource Loc}}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding CorruptedCount}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="{StaticResource PaddingMd}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconDocPage}" Width="14" Height="14"/>
                                <TextBlock Text="{Binding [FileIntegrity_ResultHeader], Source={StaticResource Loc}}" FontSize="{StaticResource FontSizeLg}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Panel>
                            <StackPanel IsVisible="{Binding !HasResults}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,40">
                                <Image Source="{StaticResource IconShield}" Width="36" Height="36" Opacity="0.4"/>
                                <TextBlock Text="{Binding [FileIntegrity_EmptyState], Source={StaticResource Loc}}"
                                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListBox IsVisible="{Binding HasResults}"
                                     ItemsSource="{Binding CheckResults}"
                                     Padding="{StaticResource PaddingIcon}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="10,8" Margin="2,3"
                                                Background="{Binding StatusBackground}">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding StatusIcon}" Width="14" Height="14"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontSizeMd}"
                                                               FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSizeXs}"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
