<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
        xmlns:loc="using:StudyDocumentManager.Markup"
                     x:Class="StudyDocumentManager.Views.FileIntegrityCheck"
             x:DataType="vm:FileIntegrityCheckModel"
             AutomationProperties.AutomationId="Screen_FileIntegrityCheck">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconIntegrity}" Width="20" Height="20"/>
                    <TextBlock Text="{loc:Localize FileIntegrity_Title}" FontSize="{StaticResource FontSizeXl}"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Classes="primary"
                            AutomationProperties.AutomationId="FileIntegrity_Scan"
                            AutomationProperties.Name="{loc:Localize FileIntegrity_BtnScan}"
                            Command="{Binding CheckIntegrityCommand}"
                            IsEnabled="{Binding !IsChecking}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{StaticResource IconSearchWhite}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:Localize FileIntegrity_BtnScan}" FontSize="{StaticResource FontSizeSm}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary"
                            AutomationProperties.AutomationId="FileIntegrity_RetryMissing"
                            AutomationProperties.Name="{loc:Localize FileIntegrity_BtnRetryMissing}"
                            Command="{Binding RetryMissingCommand}"
                            IsVisible="{Binding Results.Count}"
                            IsEnabled="{Binding !IsChecking}">
                        <TextBlock Text="{loc:Localize FileIntegrity_BtnRetryMissing}" FontSize="{StaticResource FontSizeSm}"/>
                    </Button>
                    <Button Classes="secondary"
                            AutomationProperties.AutomationId="FileIntegrity_Cancel"
                            AutomationProperties.Name="{loc:Localize FileIntegrity_BtnCancel}"
                            Command="{Binding CancelCheckCommand}"
                            IsVisible="{Binding IsChecking}">
                        <TextBlock Text="{loc:Localize FileIntegrity_BtnCancel}" FontSize="{StaticResource FontSizeSm}"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" Background="{StaticResource StatBlueBg}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{StaticResource PaddingSidebar}" Margin="0,0,0,12"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{StaticResource IconInfo}" Width="13" Height="13"/>
                    <TextBlock Text="{loc:Localize FileIntegrity_InfoHint}"
                               FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" IsVisible="{Binding IsChecking}" Margin="0,0,0,10">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <ProgressBar AutomationProperties.AutomationId="FileIntegrity_Progress"
                                 AutomationProperties.Name="{loc:Localize FileIntegrity_Checking}"
                                 IsIndeterminate="True" Width="300"/>
                    <TextBlock AutomationProperties.AutomationId="FileIntegrity_Checking"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{loc:Localize FileIntegrity_Checking}"
                               FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid>
                <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="{StaticResource PaddingMd}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Source="{StaticResource IconDocPage}" Width="14" Height="14"/>
                                    <TextBlock Text="{loc:Localize FileIntegrity_ResultHeader}" FontSize="{StaticResource FontSizeLg}"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="FileIntegrity_Status"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding StatusText}" FontSize="{StaticResource FontSizeSm}"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{loc:Localize Integrity_DatabaseLocation}"
                                               FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock AutomationProperties.AutomationId="FileIntegrity_DatabaseLocation"
                                               Text="{Binding DatabaseLocation}" FontSize="{StaticResource FontSizeXs}"
                                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Panel>
                            <StackPanel IsVisible="{Binding !Results.Count}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,40">
                                <Image Source="{StaticResource IconIntegrity}" Width="36" Height="36" Opacity="0.4"/>
                                <TextBlock Text="{loc:Localize FileIntegrity_EmptyState}"
                                           FontSize="{StaticResource FontSizeMd}" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListBox IsVisible="{Binding Results.Count}"
                                     ItemsSource="{Binding Results}"
                                     Padding="{StaticResource PaddingIcon}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="10,8" Margin="2,3"
                                                Background="{StaticResource StatRedBg}">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{StaticResource IconWarning}" Width="14" Height="14"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Document.Name}" FontSize="{StaticResource FontSizeMd}"
                                                               FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock AutomationProperties.Name="{Binding FilePath}"
                                                               Text="{Binding FilePath}" FontSize="{StaticResource FontSizeXs}"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock AutomationProperties.LiveSetting="Polite"
                                                               Text="{Binding Status}" FontSize="{StaticResource FontSizeXs}"
                                                               Foreground="{StaticResource StatRedFg}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="secondary"
                                                                AutomationProperties.AutomationId="FileIntegrity_OpenFolder"
                                                                AutomationProperties.Name="{loc:Localize Integrity_OpenContainingFolder}"
                                                                IsEnabled="{Binding !DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{loc:Localize Integrity_OpenContainingFolder}" FontSize="{StaticResource FontSizeXs}"/>
                                                        </Button>
                                                        <Button Classes="secondary"
                                                                AutomationProperties.AutomationId="FileIntegrity_CopyPath"
                                                                AutomationProperties.Name="{loc:Localize Context_CopyPath}"
                                                                IsEnabled="{Binding !DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{loc:Localize Context_CopyPath}" FontSize="{StaticResource FontSizeXs}"/>
                                                        </Button>
                                                        <Button Classes="secondary"
                                                                AutomationProperties.AutomationId="FileIntegrity_BtnRelink"
                                                                AutomationProperties.Name="{loc:Localize FileIntegrity_BtnRelink}"
                                                                IsEnabled="{Binding !DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.SelectNewFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{loc:Localize FileIntegrity_BtnRelink}" FontSize="{StaticResource FontSizeXs}"/>
                                                        </Button>
                                                        <Button Classes="secondary"
                                                                AutomationProperties.AutomationId="FileIntegrity_BtnClearPath"
                                                                AutomationProperties.Name="{loc:Localize FileIntegrity_BtnClearPath}"
                                                                IsEnabled="{Binding !DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.ClearFilePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{loc:Localize FileIntegrity_BtnClearPath}" FontSize="{StaticResource FontSizeXs}"/>
                                                        </Button>
                                                        <Button Classes="danger"
                                                                AutomationProperties.AutomationId="FileIntegrity_BtnDelete"
                                                                AutomationProperties.Name="{loc:Localize Action_Delete}"
                                                                IsEnabled="{Binding !DataContext.IsChecking, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{loc:Localize Action_Delete}" FontSize="{StaticResource FontSizeXs}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
