<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudyDocumentManager.Models"
        xmlns:v="using:StudyDocumentManager.Views"
        x:Class="StudyDocumentManager.Views.MainWindow"
        x:DataType="vm:MainWindowModel"
        Title="Study Document Manager - Professional Edition"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBackground}">

    <DockPanel>

        <!-- ═══ MENU BAR ═══ -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource CardBackground}"
              Padding="4,0" Height="30">
            <MenuItem Header="Tệp tin">
                <MenuItem Header="Thêm tài liệu mới" Command="{Binding NavigateCommand}" CommandParameter="add" InputGesture="Ctrl+N"/>
                <MenuItem Header="Mở tài liệu" Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Xuất CSV" Command="{Binding ExportCsvCommand}" InputGesture="Ctrl+E"/>
                <MenuItem Header="Sao lưu DB" Command="{Binding BackupDatabaseCommand}"/>
                <MenuItem Header="Khôi phục DB" Command="{Binding RestoreDatabaseCommand}"/>
                <Separator/>
                <MenuItem Header="Thoát" Command="{Binding ExitAppCommand}" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="Chỉnh sửa">
                <MenuItem Header="Sửa tài liệu" Command="{Binding EditDocumentCommand}" InputGesture="Ctrl+U"/>
                <MenuItem Header="Xóa tài liệu" Command="{Binding DeleteDocumentCommand}" InputGesture="Delete"/>
                <Separator/>
                <MenuItem Header="Làm mới danh sách" Command="{Binding RefreshCommand}" InputGesture="F5"/>
            </MenuItem>
            <MenuItem Header="Công cụ">
                <MenuItem Header="Quản lý Danh mục" Command="{Binding NavigateCommand}" CommandParameter="categories" InputGesture="Ctrl+M"/>
                <MenuItem Header="Bộ sưu tập" Command="{Binding NavigateCommand}" CommandParameter="collections"/>
                <Separator/>
                <MenuItem Header="Import hàng loạt" Command="{Binding NavigateCommand}" CommandParameter="batch-import"/>
                <MenuItem Header="Xóa hàng loạt" Command="{Binding NavigateCommand}" CommandParameter="bulk-delete"/>
                <MenuItem Header="Tìm trùng lặp" Command="{Binding NavigateCommand}" CommandParameter="duplicates"/>
                <MenuItem Header="Kiểm tra file" Command="{Binding NavigateCommand}" CommandParameter="integrity"/>
                <Separator/>
                <MenuItem Header="Thống kê" Command="{Binding NavigateCommand}" CommandParameter="report" InputGesture="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="Thùng rác" Command="{Binding NavigateCommand}" CommandParameter="recycle"/>
            </MenuItem>
            <MenuItem Header="Trợ giúp">
                <MenuItem Header="Kiểm tra cập nhật" Command="{Binding CheckForUpdateCommand}"/>
                <Separator/>
                <MenuItem Header="Giới thiệu" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══ TOOLBAR (like WinForms ToolStrip with many icon buttons) ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                Padding="6,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <!-- CRUD -->
                    <!-- WARNING: first button uses 16px icon (primary action) — does not inherit toolbar-btn-icon size -->
                    <Button Classes="secondary toolbar-btn" Command="{Binding NavigateCommand}" CommandParameter="add"
                            FontWeight="SemiBold">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconAdd}" Width="16" Height="16"/>
                            <TextBlock Text="Thêm" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn" Command="{Binding EditDocumentCommand}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconEdit}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Sửa" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn" Command="{Binding DeleteDocumentCommand}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconDelete}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Xóa" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="toolbar-sep"/>

                    <!-- File operations -->
                    <Button Classes="secondary toolbar-btn" Command="{Binding OpenFileCommand}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconOpenFile}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Mở file" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn" Command="{Binding ExportCsvCommand}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconExport}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Xuất" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="toolbar-sep"/>

                    <!-- Refresh + Import -->
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="batch-import">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconImport}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Import" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="toolbar-sep"/>

                    <!-- Tools: Recycle, Bulk, Recent, Backup -->
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="recycle">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconRecycle}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Thùng rác" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="bulk-delete">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconBulkDelete}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Hàng loạt" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="recentfiles">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconClock}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Gần đây" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding BackupDatabaseCommand}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconSave}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Sao lưu" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="toolbar-sep"/>

                    <!-- Analytics -->
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="duplicates">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconDuplicate}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Trùng lặp" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="report">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconReport}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="Thống kê" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary toolbar-btn"
                            Command="{Binding NavigateCommand}" CommandParameter="treemap">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconDashboard}" Classes="toolbar-btn-icon"/>
                            <TextBlock Text="TreeMap" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right side -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="secondary toolbar-btn" Command="{Binding GoBackCommand}"
                            IsVisible="{Binding CanGoBack}">
                        <StackPanel Classes="toolbar-btn-stack">
                            <Image Source="{StaticResource IconBack}" Width="12" Height="12"/>
                            <TextBlock Text="Quay lại" Classes="toolbar-btn-label"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="{StaticResource FontSizeXs}"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ STATUS BAR (bottom) ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="12,3" Height="26">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding StatusText, FallbackValue='Tổng số: 0 tài liệu'}"/>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:DashboardModel}">
                    <v:Dashboard />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AddEditModel}">
                    <v:AddEdit />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryManagementModel}">
                    <v:CategoryManagement />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:CollectionManagementModel}">
                    <v:CollectionManagement />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RecycleBinModel}">
                    <v:RecycleBin />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:BatchImportModel}">
                    <v:BatchImport />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:BulkDeleteModel}">
                    <v:BulkDelete />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:DuplicateDetectionModel}">
                    <v:DuplicateDetection />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:FileIntegrityCheckModel}">
                    <v:FileIntegrityCheck />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PersonalNoteModel}">
                    <v:PersonalNote />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RelatedDocumentsModel}">
                    <v:RelatedDocuments />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ReportModel}">
                    <v:Report />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:RecentFilesModel}">
                    <v:RecentFiles />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:TreeMapModel}">
                    <v:TreeMap />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>

</Window>
