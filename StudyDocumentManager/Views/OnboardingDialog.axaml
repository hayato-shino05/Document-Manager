<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudyDocumentManager.Models"
        xmlns:loc="using:StudyDocumentManager.Markup"
        x:Class="StudyDocumentManager.Views.OnboardingDialog"
        x:DataType="vm:OnboardingModel"
        AutomationProperties.AutomationId="Dialog_Onboarding"
        Title="{loc:Localize Onboarding_Title}"
        Width="740" Height="620"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackground}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{loc:Localize Onboarding_Welcome}"
                           AutomationProperties.AutomationId="Onboarding_Welcome"
                           FontSize="{DynamicResource FontSizeHeading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{loc:Localize Onboarding_Intro}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSm}"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,16">
            <!-- TAB 1: Quick Tour (5 Steps) -->
            <TabItem Header="{loc:Localize Onboarding_TabTour}" AutomationProperties.AutomationId="Onboarding_Tab_Tour">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                    <!-- Step Progress Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Border Background="{DynamicResource StatBlueBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusFull}" Padding="10,3">
                                <TextBlock Text="{Binding StepNumberText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource FontSizeXs}" />
                            </Border>
                        </StackPanel>
                        <ProgressBar Grid.Column="1"
                                     Margin="16,0"
                                     Value="{Binding StepProgress}"
                                     Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SidebarBackground}"
                                     CornerRadius="3" />
                    </Grid>

                    <!-- Step Cards Container -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="20">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <!-- Step 0: Search & Filters -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsStep0}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource StatBlueBg}">
                                            <Image Source="{DynamicResource IconSearch}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:Localize Onboarding_Step1_Title}"
                                                   FontSize="{DynamicResource FontSizeLg}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Localize Onboarding_Step1_Desc}"
                                               FontSize="{DynamicResource FontSizeMd}"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Localize Onboarding_Step1_Tip}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium" />
                                    </Border>
                                </StackPanel>

                                <!-- Step 1: Add Document & Drag and Drop -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsStep1}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource StatGreenBg}">
                                            <Image Source="{DynamicResource IconAdd}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:Localize Onboarding_Step2_Title}"
                                                   FontSize="{DynamicResource FontSizeLg}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Localize Onboarding_Step2_Desc}"
                                               FontSize="{DynamicResource FontSizeMd}"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Localize Onboarding_Step2_Tip}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium" />
                                    </Border>
                                </StackPanel>

                                <!-- Step 2: Dedicated Workspaces -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsStep2}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource StatBlueBg}">
                                            <Image Source="{DynamicResource IconCollection}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:Localize Onboarding_Step3_Title}"
                                                   FontSize="{DynamicResource FontSizeLg}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Localize Onboarding_Step3_Desc}"
                                               FontSize="{DynamicResource FontSizeMd}"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Localize Onboarding_Step3_Tip}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium" />
                                    </Border>
                                </StackPanel>

                                <!-- Step 3: Duplicate & Integrity -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsStep3}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource StatAmberBg}">
                                            <Image Source="{DynamicResource IconIntegrity}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:Localize Onboarding_Step4_Title}"
                                                   FontSize="{DynamicResource FontSizeLg}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Localize Onboarding_Step4_Desc}"
                                               FontSize="{DynamicResource FontSizeMd}"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Localize Onboarding_Step4_Tip}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium" />
                                    </Border>
                                </StackPanel>

                                <!-- Step 4: Recycle Bin & Recovery -->
                                <StackPanel Spacing="14" IsVisible="{Binding IsStep4}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource StatGreenBg}">
                                            <Image Source="{DynamicResource IconRestore}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:Localize Onboarding_Step5_Title}"
                                                   FontSize="{DynamicResource FontSizeLg}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Localize Onboarding_Step5_Desc}"
                                               FontSize="{DynamicResource FontSizeMd}"
                                               LineHeight="22"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Localize Onboarding_Step5_Tip}"
                                                   FontSize="{DynamicResource FontSizeSm}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                            </Panel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Feature Guide (Catalog) -->
            <TabItem Header="{loc:Localize Onboarding_TabCatalog}" AutomationProperties.AutomationId="Onboarding_Tab_Catalog">
                <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Watched Folder -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconCategory}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_WatchedFolder_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_WatchedFolder_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>

                        <!-- Import Inbox -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconImport}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_Inbox_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_Inbox_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>

                        <!-- Reports & TreeMap -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconReport}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_Reports_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_Reports_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>

                        <!-- Personal Notes & Relations -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconNote}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_Notes_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_Notes_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>

                        <!-- Archive ZIP -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconExport}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_Archive_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_Archive_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>

                        <!-- Localization -->
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Source="{DynamicResource IconSettings}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Localize Onboarding_Cat_Lang_Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{loc:Localize Onboarding_Cat_Lang_Desc}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeSm}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Shortcuts Cheatsheet -->
            <TabItem Header="{loc:Localize Onboarding_TabShortcuts}" AutomationProperties.AutomationId="Onboarding_Tab_Shortcuts">
                <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Localize Onboarding_Shortcuts_Desc}" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="{DynamicResource FontSizeSm}" Margin="0,0,0,6" />
                        
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="4">
                            <!-- Row 0: Ctrl+N -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + N" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Localize Onboarding_Step2_Title}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 1: Ctrl+Shift+I -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + Shift + I" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Localize Main_Menu_BatchImport}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 2: Ctrl+Shift+R -->
                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + Shift + R" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Localize Main_Menu_RecycleBin}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 3: Ctrl+D -->
                            <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + D" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Localize Main_Menu_DuplicateDetection}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 4: Ctrl+H -->
                            <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + H" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Localize Main_Menu_FileIntegrityCheck}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 5: Ctrl+Shift+C -->
                            <Border Grid.Row="5" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + Shift + C" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Localize Main_Menu_CategoryManagement}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 6: Ctrl+Shift+L -->
                            <Border Grid.Row="6" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Ctrl + Shift + L" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:Localize Main_Menu_CollectionManagement}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 7: Alt+Left -->
                            <Border Grid.Row="7" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="Alt + Left" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{loc:Localize Main_Menu_BackToDashboard}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 8: F5 / Ctrl+R -->
                            <Border Grid.Row="8" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="F5 / Ctrl + R" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{loc:Localize Main_Menu_Refresh}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Row 9: F1 -->
                            <Border Grid.Row="9" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}" Padding="6,2" HorizontalAlignment="Left" Margin="0,3">
                                <TextBlock Text="F1" FontWeight="Bold" FontFamily="Consolas, monospace" FontSize="{DynamicResource FontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{loc:Localize Onboarding_MenuItem}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Navigation Controls -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Skip Button -->
            <Button Grid.Column="0"
                    Name="SkipButton"
                    Content="{loc:Localize Onboarding_Skip}"
                    AutomationProperties.AutomationId="Onboarding_Skip"
                    AutomationProperties.Name="{loc:Localize Onboarding_Skip}"
                    Classes="secondary"
                    IsCancel="True"
                    Padding="{DynamicResource PaddingBtnMd}"
                    Command="{Binding SkipCommand}" />

            <!-- Right: Step Navigation & Finish Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Name="PrevButton"
                        Content="{loc:Localize Onboarding_Prev}"
                        AutomationProperties.AutomationId="Onboarding_Prev"
                        AutomationProperties.Name="{loc:Localize Onboarding_Prev}"
                        Classes="secondary"
                        Padding="{DynamicResource PaddingBtnMd}"
                        IsVisible="{Binding CanGoPrevious}"
                        Command="{Binding PreviousStepCommand}" />
                <Button Name="NextButton"
                        Content="{loc:Localize Onboarding_Next}"
                        AutomationProperties.AutomationId="Onboarding_Next"
                        AutomationProperties.Name="{loc:Localize Onboarding_Next}"
                        Classes="primary"
                        Padding="{DynamicResource PaddingBtnMd}"
                        IsVisible="{Binding CanGoNext}"
                        Command="{Binding NextStepCommand}" />
                <Button Name="FinishButton"
                        Content="{loc:Localize Onboarding_Start}"
                        AutomationProperties.AutomationId="Onboarding_Finish"
                        AutomationProperties.Name="{loc:Localize Onboarding_Start}"
                        Classes="primary"
                        Padding="{DynamicResource PaddingBtnMd}"
                        IsDefault="True"
                        IsVisible="{Binding IsLastStep}"
                        Command="{Binding FinishCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
