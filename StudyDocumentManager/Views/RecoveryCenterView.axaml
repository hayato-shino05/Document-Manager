<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             xmlns:conv="using:StudyDocumentManager.Converters"
             xmlns:core="using:StudyDocumentManager.Core.Interfaces"
             xmlns:loc="using:StudyDocumentManager.Markup"
             x:Class="StudyDocumentManager.Views.RecoveryCenterView"
             x:DataType="vm:RecoveryCenterModel"
             AutomationProperties.AutomationId="Screen_RecoveryCenter">

    <Border Classes="page-wrapper" Background="{DynamicResource ContentBackground}" Padding="{DynamicResource PaddingPage}">
        <DockPanel>
            <!-- Header: Title + Primary actions -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{DynamicResource IconRestore}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock AutomationProperties.AutomationId="Title_RecoveryCenter"
                               Text="{loc:Localize RC_Title}"
                               FontSize="{DynamicResource FontSizeHeading}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="primary" AutomationProperties.AutomationId="Recovery_CreateBackup"
                            AutomationProperties.Name="{loc:Localize RC_CreateBackup}"
                            Command="{Binding CreateBackupCommand}" Padding="{DynamicResource PaddingMd}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{DynamicResource IconSaveWhite}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:Localize RC_CreateBackup}" FontSize="{DynamicResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger" AutomationProperties.AutomationId="Recovery_RestoreSelected"
                            AutomationProperties.Name="{loc:Localize RC_Restore}"
                            Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding CanRestoreSelected}" Padding="{DynamicResource PaddingMd}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{DynamicResource IconRestoreWhite}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:Localize RC_Restore}" FontSize="{DynamicResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" AutomationProperties.AutomationId="Recovery_OpenFolder"
                            AutomationProperties.Name="{loc:Localize RC_OpenFolder}"
                            Command="{Binding OpenBackupFolderCommand}" Padding="{DynamicResource PaddingMd}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{DynamicResource IconHDD}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:Localize RC_OpenFolder}" FontSize="{DynamicResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" AutomationProperties.AutomationId="Recovery_RestoreFromFile"
                            AutomationProperties.Name="{loc:Localize RC_RestoreFromFile}"
                            Command="{Binding RestoreFromFileCommand}" Padding="{DynamicResource PaddingMd}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{DynamicResource IconOpenFile}" Width="16" Height="16"/>
                            <TextBlock Text="{loc:Localize RC_RestoreFromFile}" FontSize="{DynamicResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>

            <ScrollViewer>
                <StackPanel Spacing="12">

                    <!-- Latest backup summary -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingCard}"
                            AutomationProperties.AutomationId="Recovery_LatestCard">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{DynamicResource IconClock}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize RC_LatestBackup}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="Recovery_LatestTime"
                                           Text="{Binding LatestBackupText}" VerticalAlignment="Center"/>
                                <TextBlock FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="Recovery_LatestStatus"
                                           Text="{Binding LatestStatusText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="{DynamicResource IconCategory}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize RC_Location}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BackupLocationText}"
                                           AutomationProperties.AutomationId="Recovery_Location"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding BackupLocationText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="{loc:Localize RC_Retention}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <NumericUpDown Minimum="1" Maximum="100" Increment="1" Width="110"
                                               AutomationProperties.AutomationId="Recovery_RetentionCount"
                                               Value="{Binding RetentionCount}"/>
                                <Button Classes="secondary" AutomationProperties.AutomationId="Recovery_SaveRetention"
                                        AutomationProperties.Name="{loc:Localize RC_SaveRetention}"
                                        Command="{Binding SaveRetentionCommand}"
                                        Content="{loc:Localize RC_SaveRetention}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Versions -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <DataGrid Classes="std"
                                      AutomationProperties.AutomationId="Recovery_VersionsGrid"
                                      AutomationProperties.Name="{loc:Localize RC_Title}"
                                      ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      IsReadOnly="True"
                                      MinHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:Localize RC_ColName}" Width="*" MinWidth="260" SortMemberPath="FileName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="core:BackupVersionInfo">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                                                    <Image Source="{DynamicResource IconHDD}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Localize RC_ColCreated}" Binding="{Binding CreatedAtLocal, Mode=OneWay, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" IsReadOnly="True" Width="170" MinWidth="160"/>
                                    <DataGridTextColumn Header="{loc:Localize RC_ColSize}" Binding="{Binding SizeBytes, Mode=OneWay, Converter={x:Static conv:FileSizeConverter.Instance}}" IsReadOnly="True" Width="110" MinWidth="100"/>
                                    <DataGridTemplateColumn Header="{loc:Localize RC_ColStatus}" Width="110" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="core:BackupVersionInfo">
                                                <TextBlock Text="{Binding IsValid, Converter={x:Static conv:BackupStatusConverter.Instance}}"
                                                           VerticalAlignment="Center" Margin="8,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Classes="empty-state" IsVisible="{Binding IsLoading}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
                                <TextBlock Classes="empty-state-text"
                                           AutomationProperties.AutomationId="Recovery_LoadingState"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{loc:Localize RC_Loading}"
                                           FontSize="{DynamicResource FontSizeLg}"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>

                            <StackPanel Classes="empty-state" IsVisible="{Binding ShowEmptyState}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
                                <Image Source="{DynamicResource IconRestore}" Width="44" Height="44" Opacity="0.35" HorizontalAlignment="Center"/>
                                <TextBlock Classes="empty-state-text"
                                           AutomationProperties.AutomationId="Recovery_EmptyState"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{loc:Localize RC_EmptyState}"
                                           FontSize="{DynamicResource FontSizeLg}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- Recovery paths -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingCard}"
                            AutomationProperties.AutomationId="Recovery_LinksCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Localize RC_RecoveryPaths}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <Button Classes="secondary" AutomationProperties.AutomationId="Recovery_GoRecycleBin"
                                    Command="{Binding GoToRecycleBinCommand}"
                                    Content="{loc:Localize Menu_RecycleBin}"/>
                            <Button Classes="secondary" AutomationProperties.AutomationId="Recovery_GoIntegrity"
                                    Command="{Binding GoToFileIntegrityCommand}"
                                    Content="{loc:Localize Menu_FileCheck}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
