<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             xmlns:conv="using:StudyDocumentManager.Converters"
             xmlns:core="using:StudyDocumentManager.Core.Entities"
        xmlns:loc="using:StudyDocumentManager.Markup"
                     x:Class="StudyDocumentManager.Views.RecycleBin"
             x:DataType="vm:RecycleBinModel">

    <Border Classes="page-wrapper">
        <DockPanel>
            <!-- Header: Title + Actions -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Classes="page-header-stack" Margin="0">
                    <Image Source="{StaticResource IconRecycle}" Width="18" Height="18"/>
                    <TextBlock Classes="page-title" Text="{loc:Localize RecycleBin_Title}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Classes="primary" Command="{Binding RestoreCommand}" IsEnabled="{Binding HasSelection}" Padding="{StaticResource PaddingMd}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{StaticResource IconRestore}" Width="13" Height="13"/>
                            <TextBlock Text="{loc:Localize RecycleBin_BtnRestore}" FontSize="{StaticResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding PermanentDeleteCommand}" IsEnabled="{Binding HasSelection}" Padding="{StaticResource PaddingMd}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{StaticResource IconDelete}" Width="13" Height="13"/>
                            <TextBlock Text="{loc:Localize RecycleBin_BtnPermanentDelete}" FontSize="{StaticResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger" Command="{Binding EmptyTrashCommand}" IsEnabled="{Binding HasDeletedDocuments}" Padding="{StaticResource PaddingMd}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="{StaticResource IconRecycle}" Width="13" Height="13"/>
                            <TextBlock Text="{loc:Localize RecycleBin_BtnEmptyTrash}" FontSize="{StaticResource FontSizeMd}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- DataGrid -->
            <Border Classes="card" ClipToBounds="True">
                <Panel>
                    <DataGrid Classes="std"
                              ItemsSource="{Binding DeletedDocuments}"
                              SelectedItem="{Binding SelectedDocument}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Localize RecycleBin_ColName}" Width="*" MinWidth="200" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="core:StudyDocument">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                                            <Image Source="{Binding Type, Converter={x:Static conv:DocumentTypeIconConverter.Instance}}" 
                                                   Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Localize RecycleBin_ColSubject}" Binding="{Binding Subject}" Width="120"/>
                            <DataGridTextColumn Header="{loc:Localize RecycleBin_ColType}" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="{loc:Localize RecycleBin_ColDate}" Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Classes="empty-state" IsVisible="{Binding !DeletedDocuments.Count}">
                        <Image Classes="empty-state-icon" Source="{StaticResource IconRecycle}"/>
                        <TextBlock Classes="empty-state-text" Text="{loc:Localize RecycleBin_EmptyState}"/>
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
