<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             xmlns:loc="using:StudyDocumentManager.Markup"
             x:Class="StudyDocumentManager.Views.Report"
             x:DataType="vm:ReportModel"
             AutomationProperties.AutomationId="Screen_Report"
             AutomationProperties.AccessibilityView="Control">

    <Border Classes="page-wrapper" Background="{DynamicResource ContentBackground}" Padding="{DynamicResource PaddingPage}">
        <DockPanel>
            <!-- Header Bar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{DynamicResource IconReport}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Localize Report_Title}"
                               AutomationProperties.AutomationId="Title_Report"
                               FontSize="{DynamicResource FontSizeHeading}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="secondary"
                        AutomationProperties.AutomationId="Report_Refresh"
                        AutomationProperties.Name="{loc:Localize Report_BtnRefresh}"
                        AutomationProperties.HelpText="{loc:Localize Report_BtnRefresh}"
                        Command="{Binding LoadAllDataCommand}"
                        Padding="{DynamicResource PaddingBtnMd}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Image Source="{DynamicResource IconRefresh}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize Report_BtnRefresh}" FontSize="{DynamicResource FontSizeSm}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Scrollable Report Cards Container with Symmetrical Centering -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,24">

                    <!-- By Subject Card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingSection}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{DynamicResource IconCategory}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Report_TabSubject}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_BySubject"
                                          AutomationProperties.Name="{loc:Localize Report_TabSubject}"
                                          ItemsSource="{Binding BySubjectData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="160,*,70" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                    Background="{DynamicResource SidebarBackground}" Margin="10,0">
                                                <Border Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !BySubjectData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- By Type Card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingSection}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{DynamicResource IconDocPage}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Report_ByTypeChart}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByType"
                                          AutomationProperties.Name="{loc:Localize Report_ByTypeChart}"
                                          ItemsSource="{Binding ByTypeData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="160,*,70" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                    Background="{DynamicResource SidebarBackground}" Margin="10,0">
                                                <Border Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                        Background="{DynamicResource SuccessBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !ByTypeData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- By Status Card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingSection}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{DynamicResource IconCheckSuccess}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize RS_StatusCounts_Title}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByStatus"
                                          AutomationProperties.Name="{loc:Localize RS_StatusCounts_Title}"
                                          ItemsSource="{Binding ByStatusData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatusCountItem}">
                                        <Grid ColumnDefinitions="160,*,70" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                    Background="{DynamicResource SidebarBackground}" Margin="10,0">
                                                <Border Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                        Background="{DynamicResource BrushIconCyan}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushIconCyan}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- By Day (Last 7 Days) Card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingSection}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{DynamicResource IconCalendar}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Report_Last7Days}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByDay"
                                          AutomationProperties.Name="{loc:Localize Report_Last7Days}"
                                          ItemsSource="{Binding ByDayData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="120,*,70" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                    Background="{DynamicResource SidebarBackground}" Margin="10,0">
                                                <Border Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                        Background="{DynamicResource WarningBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !HasDayData}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- By Month (Last 12 Months) Card -->
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Padding="{DynamicResource PaddingSection}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{DynamicResource IconCalendar}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Localize Report_Last12Months}" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByMonth"
                                          AutomationProperties.Name="{loc:Localize Report_Last12Months}"
                                          ItemsSource="{Binding ByMonthData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="120,*,70" Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                    Background="{DynamicResource SidebarBackground}" Margin="10,0">
                                                <Border Height="16" CornerRadius="{DynamicResource RadiusXs}"
                                                        Background="{DynamicResource BrushIconIndigo}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushIconIndigo}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{DynamicResource FontSizeSm}" Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding !HasMonthData}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
