<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
        xmlns:loc="using:StudyDocumentManager.Markup"
                     x:Class="StudyDocumentManager.Views.Report"
             x:DataType="vm:ReportModel"
             AutomationProperties.AutomationId="Screen_Report"
             AutomationProperties.AccessibilityView="Control">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconReport}" Width="18" Height="18"/>
                    <TextBlock Text="{loc:Localize Report_Title}"
                               AutomationProperties.AutomationId="Title_Report"
                               FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="secondary"
                        AutomationProperties.AutomationId="Report_Refresh"
                        AutomationProperties.Name="{loc:Localize Report_BtnRefresh}"
                        Command="{Binding LoadAllDataCommand}" Padding="{StaticResource PaddingBtnMd}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconRefresh}" Width="16" Height="16"/>
                        <TextBlock Text="{loc:Localize Report_BtnRefresh}" FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">

                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCategory}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize Report_TabSubject}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_BySubject"
                                          AutomationProperties.Name="{loc:Localize Report_TabSubject}"
                                          ItemsSource="{Binding BySubjectData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="140,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource AccentColor}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentColor}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !BySubjectData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconDocPage}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize Report_ByTypeChart}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByType"
                                          AutomationProperties.Name="{loc:Localize Report_ByTypeChart}"
                                          ItemsSource="{Binding ByTypeData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="140,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !ByTypeData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCheck}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize RS_StatusCounts_Title}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByStatus"
                                          AutomationProperties.Name="{loc:Localize RS_StatusCounts_Title}"
                                          ItemsSource="{Binding ByStatusData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StatusCountItem}">
                                        <Grid ColumnDefinitions="140,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource BrushIconCyan}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushIconCyan}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCalendar}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize Report_Last7Days}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByDay"
                                          AutomationProperties.Name="{loc:Localize Report_Last7Days}"
                                          ItemsSource="{Binding ByDayData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="100,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource WarningBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !HasDayData}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCalendar}" Width="14" Height="14"/>
                                <TextBlock Text="{loc:Localize Report_Last12Months}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl AutomationProperties.AutomationId="Report_ByMonth"
                                          AutomationProperties.Name="{loc:Localize Report_Last12Months}"
                                          ItemsSource="{Binding ByMonthData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="100,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Label}"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource BrushIconIndigo}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushIconIndigo}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{loc:Localize Report_NoData}" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !HasMonthData}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
