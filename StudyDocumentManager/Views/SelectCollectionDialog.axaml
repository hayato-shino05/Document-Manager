<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudyDocumentManager.Views.SelectCollectionDialog"
        Title="Thêm vào Bộ sưu tập"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource ContentBackground}">

    <StackPanel Margin="24" Spacing="12">

        <!-- Document name label -->
        <TextBlock x:Name="DocNameLabel"
                   FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   TextWrapping="Wrap"/>

        <!-- Collection chips -->
        <StackPanel>
            <TextBlock Text="Chọn bộ sưu tập — click để chọn:"
                       FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText"
                       Text="(Chưa có bộ sưu tập nào — hãy tạo trong menu Bộ sưu tập)"
                       FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                       IsVisible="False" TextWrapping="Wrap"/>

            <!-- Chip list -->
            <ItemsControl x:Name="ChipsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="chip"
                                Margin="0,0,6,6"
                                Tag="{Binding Id}"
                                Click="OnChipClicked">
                            <TextBlock Text="{Binding Label}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Selected indicator -->
        <TextBlock x:Name="SelectedLabel"
                   FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextSecondary}"
                   Text="Chưa chọn bộ sưu tập nào."/>

        <!-- Buttons: OK first, then Cancel -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OkButton"
                    Content="Thêm vào"
                    Classes="primary"
                    IsDefault="True"
                    IsEnabled="False"
                    MinWidth="100"
                    HorizontalContentAlignment="Center"/>
            <Button x:Name="CancelButton"
                    Content="Hủy"
                    Classes="secondary"
                    IsCancel="True"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
