# PostgreSQL connection string used by the server-only analytics repository.
DATABASE_URL=postgres://user:password@host:5432/database

# Required for any public deployment. Keep this value in Vercel Environment Variables.
# Use a long random value and never prefix it with NEXT_PUBLIC_.
ADMIN_ACCESS_SECRET=replace-with-a-long-random-secret

# Configure the desktop app with this URL so it posts events to the public ingestion route.
# This is the desktop app setting, not a value read by the admin server at runtime.
STUDY_DOCUMENT_ANALYTICS_URL=https://your-admin-domain.example/api/events
