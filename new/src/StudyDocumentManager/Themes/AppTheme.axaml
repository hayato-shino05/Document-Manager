                <GeometryDrawing Brush="{StaticResource BrushIconNeutralLight}"
                    Geometry="M4,20 L4,14 C4,13.4 4.4,13 5,13 L7,13 C7.6,13 8,13.4 8,14 L8,20 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconAccent}"
                    Geometry="M10,20 L10,8 C10,7.4 10.4,7 11,7 L13,7 C13.6,7 14,7.4 14,8 L14,20 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconSuccess}"
                    Geometry="M16,20 L16,4 C16,3.4 16.4,3 17,3 L19,3 C19.6,3 20,3.4 20,4 L20,20 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Refresh -->
        <DrawingImage x:Key="IconRefresh">
