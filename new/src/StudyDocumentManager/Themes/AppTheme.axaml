<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ═══════════════════════════════════════════════════════════
      Study Document Manager — AppTheme v5.0
      Icon definitions only. Colors → ColorTokens.axaml
    ═══════════════════════════════════════════════════════════
    -->

    <Styles.Resources>

        <!-- ═══ ICONS — All colors reference ColorTokens keys ═══ -->

        <!-- Dashboard: simple 2×2 grid -->
        <DrawingImage x:Key="IconDashboard">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconNeutral}"
                    Geometry="M3,3 L10,3 L10,10 L3,10 Z M13,3 L20,3 L20,10 L13,10 Z M3,13 L10,13 L10,20 L3,20 Z M13,13 L20,13 L20,20 L13,20 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Add: green plus circle -->
        <DrawingImage x:Key="IconAdd">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconSuccess}"
                    Geometry="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z"/>
                <GeometryDrawing Brush="White"
                    Geometry="M11,7 L13,7 L13,11 L17,11 L17,13 L13,13 L13,17 L11,17 L11,13 L7,13 L7,11 L11,11 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Import: download arrow -->
        <DrawingImage x:Key="IconImport">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconAccent}"
                    Geometry="M11,3 L13,3 L13,13 L16,13 L12,18 L8,13 L11,13 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconNeutral}"
                    Geometry="M5,18 L5,20 C5,20.6 5.4,21 6,21 L18,21 C18.6,21 19,20.6 19,20 L19,18 L17,18 L17,19 L7,19 L7,18 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Category / Folder (2-tone, matching OpenFile) -->
        <DrawingImage x:Key="IconCategory">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconFolderBase}"
                    Geometry="M2,6 L2,19 C2,20.1 2.9,21 4,21 L20,21 C21.1,21 22,20.1 22,19 L22,8 C22,6.9 21.1,6 20,6 L12,6 L10,3 L4,3 C2.9,3 2,3.9 2,5 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconFolderFlap}"
                    Geometry="M1,10 L7,10 L8,7 L22,7 L20,21 L2,21 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Collection: stack of pages -->
        <DrawingImage x:Key="IconCollection">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconNeutralLight}"
                    Geometry="M6,2 L18,2 C19.1,2 20,2.9 20,4 L20,16 C20,17.1 19.1,18 18,18 L6,18 C4.9,18 4,17.1 4,16 L4,4 C4,2.9 4.9,2 6,2 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconAccent}"
                    Geometry="M4,6 L20,6 C21.1,6 22,6.9 22,8 L22,20 C22,21.1 21.1,22 20,22 L4,22 C2.9,22 2,21.1 2,20 L2,8 C2,6.9 2.9,6 4,6 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Recycle: trash can -->
        <DrawingImage x:Key="IconRecycle">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconDanger}"
                    Geometry="M9,1 L15,1 L15,3 L21,3 L21,5 L3,5 L3,3 L9,3 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconDanger}"
                    Geometry="M5,6 L19,6 L18,21 C18,21.6 17.6,22 17,22 L7,22 C6.4,22 6,21.6 6,21 Z"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- BulkDelete: checklist x -->
        <DrawingImage x:Key="IconBulkDelete">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconNeutral}"
                    Geometry="M4,4 L20,4 C20.6,4 21,4.4 21,5 L21,19 C21,19.6 20.6,20 20,20 L4,20 C3.4,20 3,19.6 3,19 L3,5 C3,4.4 3.4,4 4,4 Z M5,6 L5,18 L19,18 L19,6 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconDanger}"
                    Geometry="M9,9 L15,15 M15,9 L9,15"/>
            </DrawingGroup>
        </DrawingImage>

        <!-- Duplicate: two overlapping pages -->
        <DrawingImage x:Key="IconDuplicate">
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrushIconNeutralLight}"
                    Geometry="M8,2 L16,2 L20,6 L20,16 C20,17.1 19.1,18 18,18 L8,18 C6.9,18 6,17.1 6,16 L6,4 C6,2.9 6.9,2 8,2 Z"/>
                <GeometryDrawing Brush="{StaticResource BrushIconAccent}"
