<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.AddEditView"
             x:DataType="vm:AddEditViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel MaxWidth="700">

            <!-- Title -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" FontSize="18"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,16"/>

            <!-- Buttons bottom -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Classes="primary" Command="{Binding SaveCommand}" Padding="20,8"
                        HotKey="Ctrl+S"
                        ToolTip.Tip="Lưu tài liệu (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconSave}" Width="13" Height="13"/>
                        <TextBlock Text="Lưu" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding CancelCommand}" Padding="20,8"
                        HotKey="Escape"
                        ToolTip.Tip="Hủy và quay lại (Escape)">
                    <TextBlock Text="Hủy" FontSize="13"/>
                </Button>
            </StackPanel>

            <!-- Form fields -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        Padding="20">
                    <StackPanel Spacing="12">

                        <!-- Tên tài liệu -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tên tài liệu *" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBox Text="{Binding Ten, Mode=TwoWay}" FontSize="13"
                                     Watermark="Nhập tên tài liệu..." Height="32"/>
                        </StackPanel>

                        <!-- Row: Danh mục + Loại -->
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Danh mục (Môn học)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <ComboBox ItemsSource="{Binding Subjects}"
                                          SelectedItem="{Binding MonHoc, Mode=TwoWay}"
                                          IsTextSearchEnabled="True"
                                          PlaceholderText="Chọn danh mục..."
                                          FontSize="12" Height="32"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Loại tài liệu" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <ComboBox ItemsSource="{Binding Types}"
                                          SelectedItem="{Binding Loai, Mode=TwoWay}"
                                          IsTextSearchEnabled="True"
                                          PlaceholderText="Chọn loại..."
                                          FontSize="12" Height="32"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>

                        <!-- Đường dẫn file -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Đường dẫn file" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="secondary" Margin="6,0,0,0"
                                        Command="{Binding BrowseFileCommand}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Image Source="{StaticResource IconOpenFile}" Width="11" Height="11"/>
                                        <TextBlock Text="Chọn file" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding DuongDan, Mode=TwoWay}" FontSize="12"
                                         Watermark="Đường dẫn tới file..." Height="32"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Tác giả -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tác giả" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBox Text="{Binding TacGia, Mode=TwoWay}" FontSize="12"
                                     Watermark="Tên tác giả..." Height="32"/>
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tags (phân tách bằng dấu phẩy)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBox Text="{Binding Tags, Mode=TwoWay}" FontSize="12"
                                     Watermark="tag1, tag2, tag3..." Height="32"/>
                        </StackPanel>

                        <!-- Ghi chú -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ghi chú" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBox Text="{Binding GhiChu, Mode=TwoWay}" FontSize="12"
                                     Watermark="Ghi chú thêm..."
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80"/>
                        </StackPanel>

                        <!-- Row: Deadline + Quan trọng -->
                        <Grid ColumnDefinitions="*,16,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hạn chốt (Deadline)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <DatePicker SelectedDate="{Binding Deadline}" FontSize="12"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom"
                                        Margin="0,0,0,4">
                                <CheckBox Content="Đánh dấu quan trọng" FontSize="12"
                                          IsChecked="{Binding QuanTrong}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
