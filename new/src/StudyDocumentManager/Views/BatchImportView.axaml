<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.BatchImportView"
             x:DataType="vm:BatchImportViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                <Image Source="{StaticResource IconImport}" Width="18" Height="18"/>
                <TextBlock Text="Import Hàng Loạt" FontSize="18"
                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>

            <!-- Folder selection row -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBackground}" CornerRadius="6"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <DockPanel>
                        <TextBlock Text="Thư mục:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Classes="secondary"
                                Command="{Binding BrowseFolderCommand}" Padding="10,5" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{StaticResource IconCategory}" Width="11" Height="11"/>
                                <TextBlock Text="Chọn thư mục" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Classes="primary"
                                Command="{Binding ScanFolderCommand}" Padding="10,5" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{StaticResource IconScan}" Width="11" Height="11"/>
                                <TextBlock Text="Quét" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding FolderPath, Mode=TwoWay}" FontSize="12"
                                 Watermark="Nhập đường dẫn thư mục hoặc nhấn Chọn thư mục..."
                                 Height="30"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Danh mục mặc định:" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding DefaultSubject, Mode=TwoWay}" FontSize="12"
                                 Watermark="Nhập danh mục cho các tài liệu import..."
                                 Height="30" Width="250" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Bottom buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Classes="secondary" Command="{Binding SelectAllCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconCheck}" Width="11" Height="11"/>
                        <TextBlock Text="Chọn tất cả" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding DeselectAllCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconClose}" Width="11" Height="11"/>
                        <TextBlock Text="Bỏ chọn" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding ImportCommand}" Padding="16,6"
                        IsEnabled="{Binding !IsImporting}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconImport}" Width="13" Height="13"/>
                        <TextBlock Text="Import tài liệu đã chọn" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding CancelCommand}" Padding="12,6">
                    <TextBlock Text="Hủy" FontSize="12"/>
                </Button>
            </StackPanel>

            <!-- File list DataGrid -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                <Panel>
                    <DataGrid ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected}" Width="40"/>
                            <DataGridTextColumn Header="Tên file" Binding="{Binding FileName}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding FileType}" Width="70"/>
                            <DataGridTextColumn Header="Kích thước (MB)" Binding="{Binding FileSizeMB, StringFormat=\{0:F2\}}" Width="110"/>
                            <DataGridTextColumn Header="Đường dẫn" Binding="{Binding FilePath}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel IsVisible="{Binding !Files.Count}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <Image Source="{StaticResource IconCategory}" Width="36" Height="36"
                               HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="Nhập đường dẫn thư mục và nhấn Quét" FontSize="13"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
