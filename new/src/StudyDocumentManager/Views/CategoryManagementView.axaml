<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.CategoryManagementView"
             x:DataType="vm:CategoryManagementViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconCategory}" Width="18" Height="18"/>
                    <TextBlock Text="Quản lý Danh mục" FontSize="18"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Info hint -->
            <Border DockPanel.Dock="Top" Background="{StaticResource StatBlueBg}"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{StaticResource IconInfo}" Width="13" Height="13"/>
                    <TextBlock Text="Bạn có thể Thêm, Đổi tên hoặc Xóa danh mục/loại tại đây. Xóa sẽ chuyển tài liệu liên quan vào thùng rác."
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Two-column layout -->
            <Grid ColumnDefinitions="*,20,*">

                <!-- Left: Danh mục -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconCategory}" Width="13" Height="13"/>
                                    <TextBlock Text="Danh mục (Môn học)" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding AddSubjectCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAdd}" Width="11" Height="11"/>
                                            <TextBlock Text="Thêm" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding RenameSubjectCommand}" Padding="8,4"
                                            IsEnabled="{Binding SelectedSubject, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconEdit}" Width="11" Height="11"/>
                                            <TextBlock Text="Đổi tên" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding DeleteSubjectCommand}" Padding="8,4"
                                            IsEnabled="{Binding SelectedSubject, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconDelete}" Width="11" Height="11"/>
                                            <TextBlock Text="Xóa" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Subjects}"
                                 SelectedItem="{Binding SelectedSubject}"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                        <Image Source="{StaticResource IconCategory}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right: Loại tài liệu -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconDocPage}" Width="13" Height="13"/>
                                    <TextBlock Text="Loại tài liệu" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding AddTypeCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAdd}" Width="11" Height="11"/>
                                            <TextBlock Text="Thêm" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="secondary" Command="{Binding RenameTypeCommand}" Padding="8,4"
                                            IsEnabled="{Binding SelectedType, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconEdit}" Width="11" Height="11"/>
                                            <TextBlock Text="Đổi tên" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding DeleteTypeCommand}" Padding="8,4"
                                            IsEnabled="{Binding SelectedType, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconDelete}" Width="11" Height="11"/>
                                            <TextBlock Text="Xóa" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Types}"
                                 SelectedItem="{Binding SelectedType}"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                        <Image Source="{StaticResource IconDocPage}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
