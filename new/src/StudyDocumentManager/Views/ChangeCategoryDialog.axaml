<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudyDocumentManager.Views.ChangeCategoryDialog"
        Title="Đổi danh mục"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource ContentBackground}">
    <Window.Styles>
        <!-- Override AutoCompleteBox border to use accent color -->
        <Style Selector="AutoCompleteBox">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="12">

        <!-- Document name label -->
        <TextBlock x:Name="DocNameLabel"
                   FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   TextWrapping="Wrap"/>

        <!-- Existing categories as chip pills -->
        <StackPanel>
            <TextBlock Text="Danh mục hiện có — click để chọn nhanh:"
                       FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText"
                       Text="(Chưa có danh mục nào — nhập tên mới bên dưới)"
                       FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                       IsVisible="False"/>

            <!-- Chip list -->
            <ItemsControl x:Name="ChipsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}"
                                Classes="chip"
                                Margin="0,0,6,6"
                                Click="OnChipClicked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- AutoComplete input -->
        <StackPanel Spacing="4">
            <TextBlock Text="Hoặc nhập tên danh mục mới:"
                       FontSize="{StaticResource FontSizeXs}" Foreground="{StaticResource TextSecondary}"/>
            <AutoCompleteBox x:Name="CategoryInput"
                             Watermark="Tên danh mục..."
                             MinimumPrefixLength="0"
                             FilterMode="Contains"
                             Height="36"/>
        </StackPanel>

        <!-- Buttons: OK first, then Cancel -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8" Margin="0,8,0,0">
            <Button x:Name="OkButton"
                    Content="Lưu thay đổi"
                    Classes="primary"
                    IsDefault="True"
                    MinWidth="110"
                    HorizontalContentAlignment="Center"/>
            <Button x:Name="CancelButton"
                    Content="Hủy"
                    Classes="secondary"
                    IsCancel="True"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
