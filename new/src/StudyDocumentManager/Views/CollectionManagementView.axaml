<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             xmlns:conv="using:StudyDocumentManager.Converters"
             xmlns:core="using:StudyDocumentManager.Core.Entities"
             x:Class="StudyDocumentManager.Views.CollectionManagementView"
             x:DataType="vm:CollectionManagementViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,16">
                <Image Source="{StaticResource IconCollection}" Width="18" Height="18"/>
                <TextBlock Text="Quản lý Bộ sưu tập" FontSize="18"
                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>

            <Grid ColumnDefinitions="250,20,*">

                <!-- Left: Collection list -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="10,7">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconCollection}" Width="13" Height="13"/>
                                    <TextBlock Text="Bộ sưu tập" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding CreateCollectionCommand}" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAddWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="Tạo" FontSize="11" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding DeleteCollectionCommand}" Padding="8,4">
                                        <Image Source="{StaticResource IconDeleteWhite}" Width="11" Height="11"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Collections}"
                                 SelectedItem="{Binding SelectedCollection}"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CollectionItem}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                        <Image Source="{StaticResource IconCollection}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right: Documents in selected collection -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="12,8">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Tài liệu trong bộ sưu tập" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Button Classes="primary" Command="{Binding AddDocumentToCollectionCommand}" Padding="8,4" IsEnabled="{Binding SelectedCollection, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconAddWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="Thêm tài liệu" FontSize="11" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="danger" Command="{Binding RemoveSelectedDocumentsCommand}" Padding="8,4"
                                            IsEnabled="{Binding SelectedDocumentInCollection, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{StaticResource IconDeleteWhite}" Width="11" Height="11"/>
                                            <TextBlock Text="Xóa" FontSize="11" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Panel>
                            <DataGrid x:Name="DocumentGrid"
                                      ItemsSource="{Binding DocumentsInCollection}"
                                      SelectedItem="{Binding SelectedDocumentInCollection}"
                                      SelectionMode="Extended"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Tên tài liệu" Width="*" SortMemberPath="Ten">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="core:StudyDocument">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                                                    <Image Source="{Binding Loai, Converter={x:Static conv:DocumentTypeIconConverter.Instance}}" 
                                                           Width="16" Height="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Ten}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Danh mục" Binding="{Binding MonHoc}" Width="120"/>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty state -->
                            <TextBlock Text="Chọn một bộ sưu tập để xem tài liệu"
                                       IsVisible="{Binding !DocumentsInCollection.Count}"
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
