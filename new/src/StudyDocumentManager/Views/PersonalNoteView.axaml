<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.PersonalNoteView"
             x:DataType="vm:PersonalNoteViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel MaxWidth="700">
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Classes="secondary" Command="{Binding GoBackCommand}" Padding="8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconBack}" Width="12" Height="12"/>
                        <TextBlock Text="Quay lại" FontSize="11"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="{StaticResource IconNote}" Width="18" Height="18"/>
                    <TextBlock Text="Ghi chú cá nhân" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Document info -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Tài liệu:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding DocumentName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <!-- Buttons bottom -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Classes="primary" Command="{Binding SaveNoteCommand}" Padding="16,7">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconSave}" Width="13" Height="13"/>
                        <TextBlock Text="Lưu ghi chú" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Command="{Binding DeleteNoteCommand}" Padding="12,7"
                        IsVisible="{Binding HasExistingNote}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconDelete}" Width="13" Height="13"/>
                        <TextBlock Text="Xóa ghi chú" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Note editor -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    Padding="4">
                <TextBox Text="{Binding NoteContent, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontSize="13" Watermark="Viết ghi chú tại đây..."
                         BorderThickness="0"/>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
