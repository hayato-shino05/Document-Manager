<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.RelatedDocumentsView"
             x:DataType="vm:RelatedDocumentsViewModel">

    <Border Background="{StaticResource ContentBackground}" Padding="20">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Classes="secondary" Command="{Binding GoBackCommand}" Padding="8,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconBack}" Width="12" Height="12"/>
                        <TextBlock Text="Quay lại" FontSize="11"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="{StaticResource IconLink}" Width="18" Height="18"/>
                    <TextBlock Text="Tài liệu liên quan" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Document info -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Tài liệu chính:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding DocumentName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,20,*">

                <!-- Left: Current related -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconLink}" Width="13" Height="13"/>
                                <TextBlock Text="Đang liên kết" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Panel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding !!RelatedDocuments.Count}">
                                <ItemsControl ItemsSource="{Binding RelatedDocuments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RelatedDocItem}">
                                            <Border Padding="10,5" BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Classes="secondary" Padding="6,2"
                                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveRelationCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Image Source="{StaticResource IconClose}" Width="10" Height="10"/>
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Document.Ten}" FontSize="12"
                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} | {1}">
                                                                    <Binding Path="Document.MonHoc"/>
                                                                    <Binding Path="RelationType"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Chưa có liên kết nào" FontSize="12"
                                       IsVisible="{Binding !RelatedDocuments.Count}"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Right: Available to add -->
                <Border Grid.Column="2" Background="{StaticResource CardBackground}" CornerRadius="6"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}"
                                CornerRadius="6,6,0,0" Padding="10,7">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Image Source="{StaticResource IconDocPage}" Width="13" Height="13"/>
                                    <TextBlock Text="Tài liệu khả dụng" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Classes="primary"
                                        Command="{Binding AddRelationCommand}" Padding="10,4"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Image Source="{StaticResource IconAdd}" Width="11" Height="11"/>
                                        <TextBlock Text="Thêm liên kết" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding AvailableDocuments}"
                                 SelectedItem="{Binding SelectedAvailableDoc}"
                                 Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
                                        <Image Source="{StaticResource IconDocPage}" Width="11" Height="11"/>
                                        <TextBlock Text="{Binding Ten}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding MonHoc}" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>

</UserControl>
