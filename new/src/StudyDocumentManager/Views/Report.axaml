<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.Models"
             x:Class="StudyDocumentManager.Views.Report"
             x:DataType="vm:ReportModel">

    <Border Background="{StaticResource ContentBackground}" Padding="{StaticResource PaddingPage}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Source="{StaticResource IconReport}" Width="18" Height="18"/>
                    <TextBlock Text="Th?ng kê &amp; Báo cáo" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Classes="secondary"
                        Command="{Binding LoadAllDataCommand}" Padding="{StaticResource PaddingBtnMd}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="{StaticResource IconRefresh}" Width="12" Height="12"/>
                        <TextBlock Text="Làm m?i" FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">

                    <!-- Theo Danh muc -->
                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCategory}" Width="14" Height="14"/>
                                <TextBlock Text="Theo Danh m?c" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BySubjectData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="140,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource AccentColor}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentColor}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Chua có d? li?u" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !BySubjectData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Theo Loai -->
                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconDocPage}" Width="14" Height="14"/>
                                <TextBlock Text="Theo Lo?i tài li?u" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ByTypeData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="140,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Chua có d? li?u" FontSize="{StaticResource FontSizeSm}" Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding !ByTypeData.Count}" Margin="0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- = 7 Ngày Gần Nhất = -->
                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCalendar}" Width="14" Height="14"/>
                                <TextBlock Text="7 Ngày g?n nh?t" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ByDayData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="100,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource WarningBrush}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- = 12 Tháng Gần Nhất = -->
                    <Border Background="{StaticResource CardBackground}" CornerRadius="{StaticResource RadiusMd}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{StaticResource PaddingSection}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{StaticResource IconCalendar}" Width="14" Height="14"/>
                                <TextBlock Text="12 Tháng g?n nh?t" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ByMonthData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChartDataItem}">
                                        <Grid ColumnDefinitions="100,*,60" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                    Background="{StaticResource SidebarBackground}" Margin="8,0">
                                                <Border Height="18" CornerRadius="{StaticResource RadiusXs}"
                                                        Background="{StaticResource BrushIconIndigo}"
                                                        HorizontalAlignment="Left"
                                                        MinWidth="4"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeSm}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushIconIndigo}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>

</UserControl>
