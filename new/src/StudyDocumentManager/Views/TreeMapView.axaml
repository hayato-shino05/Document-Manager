<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudyDocumentManager.ViewModels"
             x:Class="StudyDocumentManager.Views.TreeMapView"
             x:DataType="vm:TreeMapViewModel">

    <Border Classes="page-wrapper">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Classes="page-header-stack" Margin="0">
                    <Image Source="{StaticResource IconTreeMap}" Width="18" Height="18"/>
                    <TextBlock Classes="page-title" Text="TreeMap — Phân bố tài liệu"/>
                </StackPanel>
            </DockPanel>

            <!-- Mode toggle row -->
            <Border DockPanel.Dock="Top" Classes="card" Padding="10,7" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Phân loại theo:" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <Button Classes="primary" Content="Danh mục"
                            Command="{Binding ShowBySubjectCommand}" Padding="10,4" FontSize="11"/>
                    <Button Classes="secondary" Content="Loại tài liệu"
                            Command="{Binding ShowByTypeCommand}" Padding="10,4" FontSize="11"/>
                    <TextBlock Text="{Binding TotalDocuments, StringFormat='Tổng: {0} tài liệu'}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- TreeMap grid -->
            <Border Classes="card" Padding="12">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TreeMapItem">
                                <Border MinWidth="120" MinHeight="80"
                                        Margin="4" Padding="12" CornerRadius="{StaticResource RadiusMd}"
                                        Background="{Binding Color}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="White" FontWeight="Bold" FontSize="14"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} tài liệu'}"
                                                   Foreground="{StaticResource OnColorPrimaryBrush}" FontSize="12"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"
                                                   Foreground="{StaticResource OnColorSecondaryBrush}" FontSize="11"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>

</UserControl>
